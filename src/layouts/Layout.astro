---
import { Font } from 'astro:assets';
import { negocio, sucursales, direccionEnLinea } from '../data/site';
import { IDIOMAS, LOCALE, idiomaDe, t, type Idioma } from '../i18n/idiomas';
import { textos } from '../i18n/textos';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  /**
   * Esta misma pagina en cada idioma. De aqui salen las etiquetas hreflang, que
   * son las que le dicen a Google que las dos versiones son la misma pagina y
   * que sirva cada una a quien corresponde.
   */
  rutas: Record<Idioma, string>;
  /** Datos estructurados de la pagina. Cada pagina declara los suyos. */
  datosEstructurados?: unknown;
  /** Para paginas que no deben acabar en el indice, como el 404. */
  noIndexar?: boolean;
}

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

const { titulo, descripcion, rutas, datosEstructurados, noIndexar } = Astro.props;

// En la portada el sufijo es el nombre completo, que es donde toca reforzar la
// marca. En las paginas internas se usa el nombre corto: con el largo, el
// titulo se pasa de los 60 caracteres que muestra Google y se corta justo por
// donde esta la informacion util.
const tituloPagina = titulo
  ? `${titulo} | ${negocio.nombreCorto}`
  : `${negocio.nombre} | ${T.tituloSufijo}`;

const descripcionPagina = descripcion ?? t(negocio.descripcion, idioma);

const urlCanonica = new URL(Astro.url.pathname, Astro.site);
const principal = sucursales[0]!;

// La imagen de compartir vive en public/ y no en src/assets: necesita una URL
// absoluta y estable, y no gana nada pasando por el optimizador.
const imagenCompartir = new URL('/og.jpg', Astro.site).href;
---

<!doctype html>
<html lang={LOCALE[idioma]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- El SVG lo usan Chrome, Firefox y Edge; el PNG es el respaldo para
         Safari y navegadores antiguos. Los dos son el poste del logo: el logo
         entero a 16 px se convierte en un cuadrado verde sin nada dentro. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={urlCanonica.href} />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloPagina}</title>
    {noIndexar && <meta name="robots" content="noindex, follow" />}
    <meta name="description" content={descripcionPagina} />
    <meta name="theme-color" content="#f5f2ea" />

    {
      IDIOMAS.map((otro) => (
        <link
          rel="alternate"
          hreflang={LOCALE[otro]}
          href={new URL(rutas[otro], Astro.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(rutas.es, Astro.site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcionPagina} />
    <meta property="og:url" content={urlCanonica.href} />
    <meta property="og:locale" content={LOCALE[idioma].replace('-', '_')} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${negocio.nombre}, ${principal.direccion.ciudad}`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloPagina} />
    <meta name="twitter:description" content={descripcionPagina} />
    <meta name="twitter:image" content={imagenCompartir} />

    <meta name="geo.region" content={`${principal.direccion.paisCodigo}-BCS`} />
    <meta name="geo.placename" content={principal.direccion.ciudad} />
    <meta
      name="business:contact_data:street_address"
      content={direccionEnLinea(principal)}
    />

    {
      /* Cada familia necesita su <Font> o no se emite su @font-face y cae al
         sustituto del sistema sin avisar. Se precargan las cuatro que aparecen
         antes del primer scroll: titulares, cuerpo, etiquetas y el rotulo de
         la cabecera. La slab no, que solo la usa el texto pequeno del logo. */
    }
    <Font cssVariable="--fuente-display" preload />
    <Font cssVariable="--fuente-texto" preload />
    <Font cssVariable="--fuente-mono" preload />
    <Font cssVariable="--fuente-marca" preload />
    <Font cssVariable="--fuente-slab" />

    {
      datosEstructurados && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(datosEstructurados)}
        />
      )
    }
  </head>
  <body>
    <a
      href="#contenido"
      class="focus:bg-salvia-600 focus:text-fondo-50 sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:px-5 focus:py-2 focus:font-semibold"
    >
      {T.saltarAlContenido}
    </a>
    <slot />
  </body>
</html>
