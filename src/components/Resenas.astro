---
import { sucursales, enlaceMapa } from '../data/site';
import { idiomaDe } from '../i18n/idiomas';
import { textos } from '../i18n/textos';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

// Solo se muestran las sucursales que tienen ficha con resenas. Si ninguna la
// tiene, la seccion entera desaparece sola.
const conValoracion = sucursales.filter((sucursal) => sucursal.valoracion);
---

{
  conValoracion.length > 0 && (
    <section id="resenas" class="border-fondo-200 border-t py-20">
      <div class="mx-auto max-w-6xl px-5">
        <div class="flex flex-col items-center gap-10 sm:flex-row sm:justify-center sm:gap-16">
          {conValoracion.map((sucursal) => (
            <a
              href={enlaceMapa(sucursal)}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col items-center text-center transition"
            >
              <span class="text-salvia-600 flex items-center gap-1" aria-hidden="true">
                {Array.from({ length: 5 }, (_, i) => (
                  <svg
                    class:list={[
                      'size-6',
                      i < Math.round(sucursal.valoracion!.puntuacion)
                        ? 'fill-current'
                        : 'fill-fondo-300',
                    ]}
                    viewBox="0 0 24 24"
                  >
                    <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01z" />
                  </svg>
                ))}
              </span>

              <p class="font-display text-tinta-900 mt-4 text-5xl leading-none">
                {sucursal.valoracion!.puntuacion.toFixed(1)}
              </p>

              <p class="text-tinta-600 mt-3 text-sm">
                {sucursal.valoracion!.total} {T.resenasEnGoogle}
                {conValoracion.length > 1 && ` · ${sucursal.nombre}`}
              </p>

              <span class="text-salvia-700 group-hover:text-salvia-800 mt-2 text-sm font-semibold underline underline-offset-4 transition">
                {T.leerResenas}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
