---
import { negocio, sucursales, enlaceWhatsapp, mensajeCita } from '../data/site';
import { preguntasFrecuentes } from '../data/faq';
import { idiomaDe } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

/**
 * Chat flotante sin API.
 *
 * No genera texto: sirve las preguntas frecuentes, que ya se derivan de los
 * datos del negocio. Si cambia un horario o un telefono, cambia la respuesta
 * del chat sola, porque sale del mismo sitio que la seccion de preguntas.
 *
 * Un modelo de lenguaje aqui necesitaria una clave, y en un sitio estatico la
 * clave viaja al navegador de cualquiera. Esto no necesita ni clave ni
 * servidor, y termina donde tiene que terminar: en WhatsApp, con una persona.
 */
const preguntas = preguntasFrecuentes(idioma);

// Con WhatsApp confirmado. Si no hubiera ninguna, el pie del chat no aparece.
const conWhatsapp = sucursales.filter((sucursal) => sucursal.whatsapp);
---

{
  /* Nace oculto y lo muestra el script. Sin JavaScript no se abriria, y un
    boton flotante que no hace nada es peor que no tenerlo: las mismas
    preguntas estan en la seccion de preguntas frecuentes de la portada. */
}
<div data-chat hidden class="fixed right-4 bottom-4 z-50 sm:right-6 sm:bottom-6">
  <!-- El panel va antes que el boton en el DOM para que, al abrirlo, el
       recorrido con tabulador entre en el panel y no salte al pie. -->
  <div
    data-chat-panel
    hidden
    role="dialog"
    aria-label={T.chatTitulo}
    class="border-fondo-300 bg-fondo-50 absolute right-0 bottom-16 flex max-h-[80vh] w-[min(22rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-2xl border shadow-2xl sm:bottom-20"
  >
    <div class="bg-salvia-600 flex items-start justify-between gap-3 px-5 py-4">
      <div>
        <p class="text-fondo-50 font-marca text-xl leading-none">
          {negocio.rotulo.principal}
        </p>
        <p
          class="text-laton-300 mt-1.5 font-mono text-[0.6rem] tracking-[0.16em] uppercase"
        >
          {T.chatTitulo}
        </p>
      </div>

      <button
        type="button"
        data-chat-cerrar
        aria-label={T.chatCerrar}
        class="text-fondo-100 hover:text-fondo-50 -mt-1 -mr-1 shrink-0 rounded-full p-1.5 transition"
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <!-- aria-live: al elegir una pregunta se anade texto aqui, y quien usa
         lector de pantalla tiene que enterarse sin volver a buscar. -->
    <div
      data-chat-hilo
      aria-live="polite"
      class="min-h-32 flex-1 space-y-3 overflow-y-auto px-5 py-5"
    >
      <p
        class="bg-fondo-150 text-tinta-700 rounded-2xl rounded-bl-sm px-4 py-3 text-sm leading-relaxed"
      >
        {T.chatIntro}
      </p>
    </div>

    <div class="border-fondo-200 max-h-64 shrink-0 overflow-y-auto border-t px-5 py-4">
      <p class="text-laton-700 font-mono text-[0.6rem] tracking-[0.16em] uppercase">
        {T.chatElegir}
      </p>

      <div data-chat-opciones class="mt-3 flex flex-wrap gap-2">
        {
          preguntas.map((entrada, indice) => (
            <button
              type="button"
              data-chat-pregunta={indice}
              data-respuesta={entrada.respuesta}
              class="border-fondo-400 text-tinta-700 hover:border-salvia-600 hover:text-salvia-700 rounded-full border px-3 py-1.5 text-left text-xs transition"
            >
              {entrada.pregunta}
            </button>
          ))
        }
      </div>

      {
        conWhatsapp.length > 0 && (
          <div class="border-fondo-200 mt-4 border-t pt-4">
            <p class="text-tinta-600 text-xs">{T.chatOtraCosa}</p>
            <div class="mt-2.5 flex flex-wrap gap-2">
              {conWhatsapp.map((sucursal) => (
                <a
                  href={enlaceWhatsapp(sucursal, mensajeCita(sucursal, idioma))}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-salvia-600 text-fondo-50 hover:bg-salvia-700 inline-flex items-center gap-1.5 rounded-full px-3.5 py-2 text-xs font-semibold transition"
                >
                  <svg
                    class="size-3.5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12.05 21.8h-.02a9.8 9.8 0 0 1-4.99-1.37l-.36-.21-3.71.97.99-3.62-.23-.37a9.8 9.8 0 0 1-1.5-5.23c0-5.42 4.41-9.83 9.83-9.83 2.63 0 5.09 1.02 6.95 2.88a9.77 9.77 0 0 1 2.88 6.95c0 5.42-4.41 9.83-9.83 9.83M20.5 3.49A11.75 11.75 0 0 0 12.05 0C5.55 0 .26 5.29.26 11.79c0 2.08.54 4.11 1.58 5.9L.16 24l6.45-1.69a11.73 11.73 0 0 0 5.44 1.35h.01c6.5 0 11.79-5.29 11.79-11.79 0-3.15-1.23-6.11-3.45-8.34" />
                  </svg>
                  {rellenar(T.chatWhatsapp, { sucursal: sucursal.nombre })}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>

  <!-- El boton lleva el poste del icono de la pestana: es la marca mas pequena
       que tenemos y la unica que se reconoce a 56 px. -->
  <button
    type="button"
    data-chat-abrir
    aria-expanded="false"
    aria-label={T.chatAbrir}
    class="bg-salvia-600 hover:bg-salvia-700 focus-visible:outline-salvia-700 flex size-14 items-center justify-center rounded-2xl shadow-xl transition"
  >
    <svg class="size-8" viewBox="0 0 100 100" aria-hidden="true">
      <path
        d="M34.37 12 L65.63 22.42 L65.63 34.15 L34.37 23.73 Z M34.37 28.07 L65.63 38.49 L65.63 50.22 L34.37 39.79 Z M34.37 44.14 L65.63 54.56 L65.63 66.29 L34.37 55.86 Z M34.37 60.21 L65.63 70.63 L65.63 82.35 L34.37 71.93 Z M34.37 76.27 L65.63 86.7 L65.63 98.42 L34.37 88 Z"
        fill="#f7f5f1"></path>
    </svg>
  </button>
</div>

<script>
  const chat = document.querySelector<HTMLElement>('[data-chat]');
  const panel = chat?.querySelector<HTMLElement>('[data-chat-panel]');
  const abrir = chat?.querySelector<HTMLButtonElement>('[data-chat-abrir]');
  const cerrar = chat?.querySelector<HTMLButtonElement>('[data-chat-cerrar]');
  const hilo = chat?.querySelector<HTMLElement>('[data-chat-hilo]');

  if (chat && panel && abrir && cerrar && hilo) {
    // Ya hay JavaScript, asi que el boton puede aparecer sin dejar un control
    // muerto para quien no lo tenga.
    chat.hidden = false;

    const preguntas = [
      ...chat.querySelectorAll<HTMLButtonElement>('[data-chat-pregunta]'),
    ];

    const abierto = () => !panel.hidden;

    const alternar = (mostrar: boolean) => {
      panel.hidden = !mostrar;
      abrir.setAttribute('aria-expanded', String(mostrar));
      if (mostrar) cerrar.focus();
      else abrir.focus();
    };

    abrir.addEventListener('click', () => alternar(!abierto()));
    cerrar.addEventListener('click', () => alternar(false));

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && abierto()) alternar(false);
    });

    const burbuja = (texto: string, mia: boolean) => {
      const p = document.createElement('p');
      p.textContent = texto;
      p.className = mia
        ? 'ml-auto max-w-[85%] rounded-2xl rounded-br-sm bg-salvia-600 px-4 py-2.5 text-sm text-fondo-50'
        : 'max-w-[90%] rounded-2xl rounded-bl-sm bg-fondo-150 px-4 py-3 text-sm leading-relaxed text-tinta-700';
      hilo.append(p);
    };

    preguntas.forEach((boton) => {
      boton.addEventListener('click', () => {
        burbuja(boton.textContent?.trim() ?? '', true);
        burbuja(boton.dataset.respuesta ?? '', false);
        // Una pregunta ya contestada deja de ofrecerse: repetirla no aporta y
        // la lista se acorta segun se usa.
        boton.remove();
        hilo.scrollTo({ top: hilo.scrollHeight, behavior: 'smooth' });
      });
    });
  }
</script>
