---
import { negocio } from '../data/site';
import { IDIOMA_POR_DEFECTO, idiomaDe, type Idioma } from '../i18n/idiomas';
import { navegacion, textos } from '../i18n/textos';
// Va incrustado y no como <img>: asi el SVG hereda las fuentes de la pagina.
// Un <img src="logo.svg"> es un documento aislado y no las ve.
import Logo from '../assets/marca/logo.svg';

interface Props {
  /** Esta misma pagina en cada idioma, para el conmutador. */
  rutas: Record<Idioma, string>;
  /**
   * La pagina abre con una portada a sangre. Entonces la cabecera empieza
   * transparente y sobre la foto, y se vuelve solida en cuanto se baja. Las
   * paginas de sucursal y de servicio abren en crema, asi que no lo usan.
   */
  sobreHero?: boolean;
}

const { rutas, sobreHero = false } = Astro.props;

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);
const enlaces = navegacion(idioma);

// El otro idioma, que es al que lleva el conmutador.
const otroIdioma: Idioma = idioma === 'es' ? 'en' : 'es';
const otroTextos = textos(otroIdioma);
---

{
  /* data-sobre-hero lo lee el script: mientras la portada esta a la vista la
     cabecera va sin fondo, y al bajar aparece. Sin JavaScript se queda solida
     desde el principio, que es el estado legible. */
}
<header
  data-cabecera
  data-sobre-hero={sobreHero ? '' : undefined}
  class:list={[
    'fixed inset-x-0 top-0 z-40 border-b transition-colors duration-300',
    sobreHero
      ? '[&:not([data-arriba])]:border-fondo-300/70 [&:not([data-arriba])]:bg-fondo-50/85 border-transparent bg-transparent [&:not([data-arriba])]:backdrop-blur-md'
      : 'border-fondo-300/70 bg-fondo-50/85 backdrop-blur-md',
  ]}
>
  <div class="mx-auto flex h-20 max-w-6xl items-center justify-between gap-4 px-5">
    <a
      href={rutas[idioma]}
      class="group flex items-center gap-3"
      aria-label={`${negocio.nombre}, ${T.inicio}`}
    >
      <Logo class="size-11 shrink-0 rounded-full" />
      <span class="leading-none">
        <span class="font-marca text-tinta-900 block text-2xl tracking-wide">
          {negocio.rotulo.principal}
        </span>
        <span
          class="text-laton-700 block font-mono text-[0.6rem] tracking-[0.22em] uppercase"
        >
          {negocio.rotulo.secundaria}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label={T.navPrincipal}>
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            class="text-tinta-600 hover:text-salvia-700 text-sm font-medium transition"
          >
            {enlace.etiqueta}
          </a>
        ))
      }

      <a
        href={rutas[otroIdioma]}
        hreflang={otroIdioma === IDIOMA_POR_DEFECTO ? 'es-MX' : 'en-US'}
        class="text-tinta-500 hover:text-salvia-700 text-sm font-medium underline underline-offset-4 transition"
      >
        {otroTextos.idiomaActual}
      </a>

      <a
        href="#sucursales"
        data-cita
        class="bg-salvia-600 text-fondo-50 hover:bg-salvia-700 rounded-full px-5 py-2.5 text-sm font-semibold transition"
      >
        {T.agendarCita}
      </a>
    </nav>

    <button
      type="button"
      id="boton-menu"
      class="border-fondo-300 text-tinta-700 hover:border-salvia-600 hover:text-salvia-700 flex size-11 items-center justify-center rounded-lg border transition md:hidden"
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label={T.abrirMenu}
      data-abrir={T.abrirMenu}
      data-cerrar={T.cerrarMenu}
    >
      <svg
        id="icono-abrir"
        class="size-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        id="icono-cerrar"
        class="hidden size-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <nav
    id="menu-movil"
    class="border-fondo-300/70 bg-fondo-50/95 hidden border-t px-5 pt-2 pb-6 md:hidden"
    aria-label={T.navPrincipalMovil}
  >
    <ul class="flex flex-col">
      {
        enlaces.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              class="border-fondo-200 text-tinta-900 hover:text-salvia-700 block border-b py-4 text-lg font-medium transition"
            >
              {enlace.etiqueta}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={rutas[otroIdioma]}
          class="border-fondo-200 text-tinta-500 hover:text-salvia-700 block border-b py-4 text-lg font-medium transition"
        >
          {otroTextos.idiomaActual}
        </a>
      </li>
    </ul>
    <a
      href="#sucursales"
      class="bg-salvia-600 text-fondo-50 mt-6 block rounded-full px-5 py-3.5 text-center font-semibold"
    >
      {T.agendarCita}
    </a>
  </nav>

  <div class="franja-poste" aria-hidden="true"></div>
</header>

<script>
  const boton = document.getElementById('boton-menu');
  const menu = document.getElementById('menu-movil');
  const iconoAbrir = document.getElementById('icono-abrir');
  const iconoCerrar = document.getElementById('icono-cerrar');

  if (boton && menu && iconoAbrir && iconoCerrar) {
    // Las etiquetas vienen del HTML para que el script no tenga que saber en
    // que idioma esta la pagina.
    const etiquetaAbrir = boton.dataset.abrir ?? 'Abrir menu';
    const etiquetaCerrar = boton.dataset.cerrar ?? 'Cerrar menu';

    const alternar = (abierto: boolean) => {
      menu.classList.toggle('hidden', !abierto);
      iconoAbrir.classList.toggle('hidden', abierto);
      iconoCerrar.classList.toggle('hidden', !abierto);
      boton.setAttribute('aria-expanded', String(abierto));
      boton.setAttribute('aria-label', abierto ? etiquetaCerrar : etiquetaAbrir);
    };

    boton.addEventListener('click', () => {
      alternar(menu.classList.contains('hidden'));
    });

    // Al elegir una seccion el menu estorba: se cierra solo.
    menu.querySelectorAll('a').forEach((enlace) => {
      enlace.addEventListener('click', () => alternar(false));
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && !menu.classList.contains('hidden')) {
        alternar(false);
        boton.focus();
      }
    });
  }
</script>

<script>
  /**
   * La cabecera va sin fondo mientras la portada a sangre esta detras, y se
   * vuelve solida en cuanto se pasa. Se calcula con el borde inferior de la
   * portada y no con un umbral fijo de scroll: asi funciona igual con la
   * portada de 92vh en cualquier pantalla.
   *
   * Sin JavaScript la cabecera se queda solida desde el principio, que es el
   * estado legible: nunca queda texto claro sobre fondo claro.
   */
  const cabecera = document.querySelector<HTMLElement>(
    '[data-cabecera][data-sobre-hero]',
  );
  const portada = document.querySelector<HTMLElement>('#inicio');

  if (cabecera && portada) {
    let pendiente = false;

    const revisar = () => {
      const limite = portada.getBoundingClientRect().bottom - cabecera.offsetHeight;
      cabecera.toggleAttribute('data-arriba', limite > 0);
    };

    const alDesplazar = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        revisar();
        pendiente = false;
      });
    };

    window.addEventListener('scroll', alDesplazar, { passive: true });
    window.addEventListener('resize', alDesplazar, { passive: true });
    revisar();
  }
</script>
