---
import { Image } from 'astro:assets';
import { negocio, serviciosPrivados } from '../data/site';
import { idiomaDe, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';
import juanCarlos from '../assets/galeria/privados-juan-carlos.jpg';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

/**
 * La seccion existe en cuanto hay alguien a quien escribir. La lista de
 * servicios es opcional: se sostiene con la foto y el contacto, porque lo que
 * se ofrece aqui es hablar con una persona, no elegir de una carta.
 *
 * Sin contacto no se muestra. Invitar a escribir a un numero que no esta
 * puesto es peor que no tener la seccion.
 */
const contacto = negocio.privados;
const whatsapp = contacto?.whatsapp
  ? `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(T.privadosAsunto)}`
  : undefined;
---

{
  /* Banda oscura a sangre, la unica de la portada despues de las de servicio.
    Sus dos vecinas (sucursales y preguntas) son claras, asi que el salto a
    verde profundo aisla esta seccion y la separa del resto de la carta: es
    justo lo que es, un servicio que no se agenda como los demas.

    El lujo sale de los recursos que ya tiene el sitio (verde de marca, filete
    de laton, serif grande y mucho aire) y no de fotos de villas o playas, que
    no existen en el proyecto. Poner aqui una imagen de banco seria vender el
    servicio con la casa de otro. */
}
{
  contacto && (
    <section id="privados" class="bg-salvia-950 overflow-hidden">
      <div class="mx-auto grid max-w-7xl lg:grid-cols-[1fr_0.85fr]">
        <div class="flex items-center px-5 py-24 sm:px-10 md:py-32 lg:px-14">
          <div class="w-full max-w-xl">
            <p class="antetitulo antetitulo-claro">{T.privadosEtiqueta}</p>

            <h2 class="text-fondo-50 mt-8 text-6xl sm:text-7xl">{T.privadosTitulo}</h2>

            <p class="text-fondo-100 mt-7 text-lg leading-relaxed">
              {T.privadosDescripcion}
            </p>

            {/* Donde se presta, con el mismo filete de laton que abre cada
                antetitulo: la pieza ya existe en el sitio y aqui se repite en
                pequeno en vez de inventar un adorno nuevo. */}
            <ul class="border-laton-700 mt-12 grid gap-4 border-t pt-8">
              {T.privadosLugares.map((lugar) => (
                <li class="text-fondo-100 flex items-center gap-4 font-mono text-[0.7rem] tracking-[0.16em] uppercase">
                  <span class="bg-laton-400 h-px w-7 shrink-0" aria-hidden="true" />
                  {lugar}
                </li>
              ))}
            </ul>

            {/* Solo si algun dia se detallan. Sin lista la seccion funciona
                igual: lo que se ofrece es hablar con alguien. */}
            {serviciosPrivados.length > 0 && (
              <ul class="border-salvia-800 mt-12 border-t">
                {serviciosPrivados.map((servicio) => (
                  <li class="border-salvia-800 border-b py-5">
                    <div class="flex items-baseline justify-between gap-6">
                      <h3 class="text-fondo-50 text-2xl">{t(servicio.nombre, idioma)}</h3>
                      {servicio.precioDesde !== undefined && (
                        <p class="font-display text-laton-300 shrink-0 text-2xl leading-none tabular-nums">
                          {`${T.privadosDesde} $${servicio.precioDesde}`}
                        </p>
                      )}
                    </div>
                    <p class="text-fondo-100 mt-2 max-w-lg text-sm leading-relaxed">
                      {t(servicio.descripcion, idioma)}
                    </p>
                  </li>
                ))}
              </ul>
            )}

            <div class="mt-12 flex flex-wrap items-center gap-x-10 gap-y-5">
              {whatsapp ? (
                <a
                  href={whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-fondo-50 text-salvia-700 hover:bg-fondo-150 inline-flex items-center gap-2.5 rounded-full px-9 py-4 font-semibold transition"
                >
                  <svg
                    class="size-5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12.05 21.8h-.02a9.8 9.8 0 0 1-4.99-1.37l-.36-.21-3.71.97.99-3.62-.23-.37a9.8 9.8 0 0 1-1.5-5.23c0-5.42 4.41-9.83 9.83-9.83 2.63 0 5.09 1.02 6.95 2.88a9.77 9.77 0 0 1 2.88 6.95c0 5.42-4.41 9.83-9.83 9.83M20.5 3.49A11.75 11.75 0 0 0 12.05 0C5.55 0 .26 5.29.26 11.79c0 2.08.54 4.11 1.58 5.9L.16 24l6.45-1.69a11.73 11.73 0 0 0 5.44 1.35h.01c6.5 0 11.79-5.29 11.79-11.79 0-3.15-1.23-6.11-3.45-8.34" />
                  </svg>
                  {rellenar(T.privadosBoton, { nombre: contacto.nombre })}
                </a>
              ) : (
                <p class="font-display text-fondo-50 text-3xl">{contacto.nombre}</p>
              )}

              <a
                href={`tel:${contacto.telefono.replace(/\s/g, '')}`}
                class="text-fondo-100 hover:text-laton-300 font-mono text-sm tabular-nums transition"
              >
                {contacto.telefono}
              </a>
            </div>
          </div>
        </div>

        {/* Juan Carlos trabajando fuera del local: es lo que distingue a este
            servicio del resto de la carta, y se entiende sin leer nada.

            Va a sangre contra el borde, sin marco ni esquina redondeada: la
            tarjeta flotando en crema la dejaba al nivel del resto de bloques, y
            esta seccion tiene que leerse aparte. En movil se queda en 4:5, que
            es la proporcion de la foto. */}
        <figure class="relative min-h-[26rem] lg:min-h-0">
          <Image
            src={juanCarlos}
            alt={rellenar(T.privadosFoto, { nombre: contacto.nombre })}
            widths={[400, 800, 1200]}
            sizes="(max-width: 1023px) 100vw, 45vw"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 size-full object-cover"
          />
        </figure>
      </div>
    </section>
  )
}
