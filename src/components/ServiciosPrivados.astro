---
import { negocio, serviciosPrivados } from '../data/site';
import { idiomaDe, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';
import TituloSeccion from './TituloSeccion.astro';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

/**
 * La seccion solo existe si hay servicios que ofrecer y un correo al que
 * escribir. Invitar a escribir a una direccion que no esta puesta seria peor
 * que no tener la seccion.
 */
const visible = serviciosPrivados.length > 0 && Boolean(negocio.email);
const mailto = negocio.email
  ? `mailto:${negocio.email}?subject=${encodeURIComponent(T.privadosAsunto)}`
  : '';
---

{
  visible && (
    <section id="privados" class="border-fondo-200 bg-pared-100 border-t py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-5">
        <TituloSeccion
          etiqueta={T.privadosEtiqueta}
          titulo={T.privadosTitulo}
          descripcion={T.privadosDescripcion}
        />

        <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {serviciosPrivados.map((servicio) => (
            <li class="border-fondo-300 bg-fondo-50 flex flex-col rounded-2xl border p-7">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-3xl leading-none">{t(servicio.nombre, idioma)}</h3>
                {servicio.precioDesde !== undefined && (
                  <p class="font-display text-salvia-500 shrink-0 text-2xl leading-none">
                    {`${T.privadosDesde} $${servicio.precioDesde}`}
                  </p>
                )}
              </div>
              <p class="text-tinta-600 mt-4 text-sm leading-relaxed">
                {t(servicio.descripcion, idioma)}
              </p>
            </li>
          ))}
        </ul>

        <a
          href={mailto}
          class="bg-salvia-600 text-fondo-50 hover:bg-salvia-700 mt-10 inline-flex items-center gap-2.5 rounded-full px-8 py-4 font-semibold transition"
        >
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3.5 7 8.5 6 8.5-6" stroke-linejoin="round" />
          </svg>
          {rellenar(T.privadosBoton, { correo: negocio.email ?? '' })}
        </a>
      </div>
    </section>
  )
}
