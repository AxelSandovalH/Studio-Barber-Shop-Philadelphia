---
import { Image } from 'astro:assets';
import { negocio, serviciosPrivados } from '../data/site';
import { idiomaDe, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';
import juanCarlos from '../assets/galeria/privados-juan-carlos.jpg';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

/**
 * La seccion existe en cuanto hay alguien a quien escribir. La lista de
 * servicios es opcional: se sostiene con la foto y el contacto, porque lo que
 * se ofrece aqui es hablar con una persona, no elegir de una carta.
 *
 * Sin contacto no se muestra. Invitar a escribir a un numero que no esta
 * puesto es peor que no tener la seccion.
 */
const contacto = negocio.privados;
const whatsapp = contacto?.whatsapp
  ? `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(T.privadosAsunto)}`
  : undefined;
---

{
  contacto && (
    <section
      id="privados"
      class="border-fondo-200 bg-pared-100 overflow-hidden border-t py-24 md:py-32"
    >
      <div class="mx-auto max-w-6xl px-5">
        <div class="grid items-center gap-12 lg:grid-cols-[1fr_0.85fr] lg:gap-20">
          <div>
            <p class="antetitulo">{T.privadosEtiqueta}</p>

            <h2 class="mt-6 text-5xl sm:text-6xl">{T.privadosTitulo}</h2>

            <p class="text-tinta-600 mt-6 max-w-lg text-lg leading-relaxed">
              {T.privadosDescripcion}
            </p>

            {/* Solo si algun dia se detallan. Sin lista la seccion funciona
                igual: lo que se ofrece es hablar con alguien. */}
            {serviciosPrivados.length > 0 && (
              <ul class="border-fondo-300 mt-10 border-t">
                {serviciosPrivados.map((servicio) => (
                  <li class="border-fondo-300 border-b py-5">
                    <div class="flex items-baseline justify-between gap-6">
                      <h3 class="text-2xl">{t(servicio.nombre, idioma)}</h3>
                      {servicio.precioDesde !== undefined && (
                        <p class="font-display text-salvia-500 shrink-0 text-2xl leading-none tabular-nums">
                          {`${T.privadosDesde} $${servicio.precioDesde}`}
                        </p>
                      )}
                    </div>
                    <p class="text-tinta-600 mt-2 max-w-lg text-sm leading-relaxed">
                      {t(servicio.descripcion, idioma)}
                    </p>
                  </li>
                ))}
              </ul>
            )}

            <div class="border-fondo-300 mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 border-t pt-8">
              {whatsapp ? (
                <a
                  href={whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-salvia-600 text-fondo-50 hover:bg-salvia-700 inline-flex items-center gap-2.5 rounded-full px-8 py-4 font-semibold transition"
                >
                  <svg
                    class="size-5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12.05 21.8h-.02a9.8 9.8 0 0 1-4.99-1.37l-.36-.21-3.71.97.99-3.62-.23-.37a9.8 9.8 0 0 1-1.5-5.23c0-5.42 4.41-9.83 9.83-9.83 2.63 0 5.09 1.02 6.95 2.88a9.77 9.77 0 0 1 2.88 6.95c0 5.42-4.41 9.83-9.83 9.83M20.5 3.49A11.75 11.75 0 0 0 12.05 0C5.55 0 .26 5.29.26 11.79c0 2.08.54 4.11 1.58 5.9L.16 24l6.45-1.69a11.73 11.73 0 0 0 5.44 1.35h.01c6.5 0 11.79-5.29 11.79-11.79 0-3.15-1.23-6.11-3.45-8.34" />
                  </svg>
                  {rellenar(T.privadosBoton, { nombre: contacto.nombre })}
                </a>
              ) : (
                <p class="font-display text-tinta-900 text-3xl">{contacto.nombre}</p>
              )}

              <a
                href={`tel:${contacto.telefono.replace(/\s/g, '')}`}
                class="text-tinta-900 hover:text-salvia-700 font-mono text-sm tabular-nums transition"
              >
                {contacto.telefono}
              </a>
            </div>
          </div>

          {/* Juan Carlos trabajando fuera del local: es lo que distingue a este
              servicio del resto de la carta, y se entiende sin leer nada. */}
          <figure class="border-fondo-300 bg-fondo-150 overflow-hidden rounded-2xl border">
            <Image
              src={juanCarlos}
              alt={rellenar(T.privadosFoto, { nombre: contacto.nombre })}
              widths={[400, 800, 1200]}
              sizes="(max-width: 1023px) 92vw, 38vw"
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] size-full object-cover"
            />
          </figure>
        </div>
      </div>
    </section>
  )
}
