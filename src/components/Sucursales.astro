---
import { sucursales } from '../data/site';
import { idiomaDe } from '../i18n/idiomas';
import { segunCuantas, textos } from '../i18n/textos';
import TituloSeccion from './TituloSeccion.astro';
import TarjetaSucursal from './TarjetaSucursal.astro';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);
---

<section
  id="sucursales"
  class="border-fondo-200 bg-pared-100 border-t py-24 md:py-32 lg:py-16"
>
  <div class="mx-auto max-w-6xl px-5">
    <TituloSeccion
      etiqueta={T.sucursalesEtiqueta}
      titulo={T.sucursalesTitulo}
      descripcion={segunCuantas(
        sucursales.length,
        T.sucursalesDescripcionUna,
        T.sucursalesDescripcion,
      )}
    />

    {
      /* Varias sucursales van una al lado de otra: son una eleccion, no una
        lista, y comparadas de un vistazo se elige antes. Con una sola no hay
        nada que comparar, asi que ocupa el ancho y usa la disposicion amplia,
        con el mapa al lado de los datos en vez de encima. */
    }
    <div
      class:list={['mt-14 grid gap-6 lg:mt-8', sucursales.length > 1 && 'lg:grid-cols-2']}
    >
      {
        sucursales.map((sucursal) => (
          <TarjetaSucursal sucursal={sucursal} compacta={sucursales.length > 1} />
        ))
      }
    </div>
  </div>
</section>
