---
import { sucursales } from '../data/site';
import { idiomaDe } from '../i18n/idiomas';
import { textos } from '../i18n/textos';
import TituloSeccion from './TituloSeccion.astro';
import TarjetaSucursal from './TarjetaSucursal.astro';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);
---

<section id="sucursales" class="border-fondo-200 bg-fondo-100/40 border-t py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <TituloSeccion
      etiqueta={T.sucursalesEtiqueta}
      titulo={T.sucursalesTitulo}
      descripcion={T.sucursalesDescripcion}
    />

    <div class="mt-14 space-y-6">
      {sucursales.map((sucursal) => <TarjetaSucursal sucursal={sucursal} />)}
    </div>
  </div>
</section>
