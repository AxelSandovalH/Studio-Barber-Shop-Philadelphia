---
import { servicios, moneda } from '../data/site';
import TituloSeccion from './TituloSeccion.astro';

// Si todavia no hay ningun precio cargado no tiene sentido anunciar la moneda.
const hayPrecios = servicios.some((servicio) => servicio.precio !== undefined);
---

<section id="servicios" class="border-tinta-800 border-t py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <TituloSeccion
      etiqueta="Carta de servicios"
      titulo="Lo que hacemos"
      descripcion="Corte, barba y color. Elige la sucursal que te quede mas cerca y agenda tu cita."
    />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        servicios.map((servicio) => (
          <li
            class:list={[
              'group relative flex flex-col rounded-2xl border p-7 transition',
              servicio.destacado
                ? 'border-laton-500/45 bg-laton-500/[0.06] hover:border-laton-400'
                : 'border-tinta-700 bg-tinta-900/60 hover:border-tinta-600',
            ]}
          >
            {servicio.destacado && (
              <span class="bg-laton-500 text-tinta-950 absolute -top-2.5 left-7 rounded-full px-3 py-0.5 text-[0.65rem] font-bold tracking-[0.12em] uppercase">
                Mas pedido
              </span>
            )}

            <div class="flex items-start justify-between gap-4">
              <h3 class="text-3xl leading-none">{servicio.nombre}</h3>
              <p
                class:list={[
                  'shrink-0 leading-none',
                  servicio.precio !== undefined
                    ? 'font-display text-laton-400 text-3xl'
                    : 'text-hueso-400 text-xs font-semibold tracking-[0.12em] uppercase',
                ]}
              >
                {servicio.precio !== undefined ? `$${servicio.precio}` : 'Consultar'}
              </p>
            </div>

            <p class="text-hueso-300 mt-4 flex-1 text-sm leading-relaxed">
              {servicio.descripcion}
            </p>

            {servicio.duracion !== undefined && (
              <p class="text-hueso-400 mt-6 flex items-center gap-2 text-xs font-medium tracking-[0.14em] uppercase">
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" stroke-linecap="round" />
                </svg>
                Unos {servicio.duracion} min
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <p class="text-hueso-400 mt-10 text-sm">
      {hayPrecios && `${moneda.nota} `}Atendemos con y sin cita. Para asegurar tu hora,
      <a
        href="#sucursales"
        class="text-laton-400 hover:text-laton-300 font-semibold underline underline-offset-4"
      >
        escribenos a la sucursal que prefieras</a
      >.
    </p>
  </div>
</section>
