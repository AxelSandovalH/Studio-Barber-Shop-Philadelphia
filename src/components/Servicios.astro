---
import { servicios, moneda } from '../data/site';
import { idiomaDe, rutaInicio, rutaServicio, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';
import TituloSeccion from './TituloSeccion.astro';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

// Si todavia no hay ningun precio cargado no tiene sentido anunciar la moneda.
const hayPrecios = servicios.some((servicio) => servicio.precio !== undefined);

// Absoluto y no "#sucursales": este bloque tambien se usa en las paginas de
// sucursal, donde ese ancla no existe y el enlace no llevaria a ninguna parte.
const enlaceSucursales = `${rutaInicio(idioma)}#sucursales`;
---

<section id="servicios" class="border-fondo-200 border-t py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <TituloSeccion
      etiqueta={T.serviciosEtiqueta}
      titulo={T.serviciosTitulo}
      descripcion={T.serviciosDescripcion}
    />

    {
      /* Carta y no rejilla de tarjetas: en una barberia los servicios se leen
        como una lista de precios, uno debajo de otro, y el filete entre lineas
        hace ese trabajo mejor que ocho cajas con borde. */
    }
    <ul class="border-fondo-200 mx-auto mt-16 max-w-4xl border-t">
      {
        servicios.map((servicio) => (
          <li class="border-fondo-200 border-b">
            {/* La fila entera es el enlace: en una carta, el area de toque
                natural es el renglon, no el nombre suelto. */}
            <a
              href={rutaServicio(idioma, servicio.clave)}
              class="group flex items-baseline gap-6 py-7"
            >
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <h3 class="group-hover:text-salvia-700 text-3xl transition sm:text-4xl">
                    {t(servicio.nombre, idioma)}
                  </h3>
                  {servicio.destacado && (
                    <span class="text-laton-700 border-laton-400 rounded-full border px-2.5 py-0.5 font-mono text-[0.62rem] tracking-[0.14em] uppercase">
                      {T.masPedido}
                    </span>
                  )}
                </div>
                <p class="text-tinta-600 mt-2.5 max-w-lg text-sm leading-relaxed">
                  {t(servicio.descripcion, idioma)}
                </p>
              </div>

              {/* El filete de puntos une nombre y precio como en una carta
                  impresa. Es decorativo, asi que se oculta a los lectores. */}
              <span
                class="border-fondo-300 hidden flex-1 border-b border-dotted sm:block"
                aria-hidden="true"
              />

              <div class="shrink-0 text-right">
                <p
                  class:list={[
                    'leading-none',
                    servicio.precio !== undefined
                      ? 'font-display text-salvia-500 text-3xl tabular-nums sm:text-4xl'
                      : 'text-tinta-500 font-mono text-xs tracking-[0.14em] uppercase',
                  ]}
                >
                  {servicio.precio !== undefined
                    ? `${servicio.desde ? T.precioDesde + ' ' : ''}$${servicio.precio}`
                    : T.consultar}
                </p>
                {servicio.duracion !== undefined && (
                  <p class="text-tinta-500 mt-2 font-mono text-[0.7rem] tracking-[0.12em] uppercase">
                    {rellenar(T.unosMinutos, { n: servicio.duracion })}
                  </p>
                )}
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="text-tinta-500 mx-auto mt-10 max-w-4xl text-sm">
      {hayPrecios && `${t(moneda.nota, idioma)} `}{T.serviciosPie}{' '}
      <a
        href={enlaceSucursales}
        class="text-salvia-700 hover:text-salvia-800 font-semibold underline underline-offset-4"
      >
        {T.serviciosPieEnlace}</a
      >.
    </p>
  </div>
</section>
