---
import { Image } from 'astro:assets';
import { servicios, moneda, retratosDeServicio } from '../data/site';
import { idiomaDe, rutaInicio, rutaServicio, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

// Si todavia no hay ningun precio cargado no tiene sentido anunciar la moneda.
const hayPrecios = servicios.some((servicio) => servicio.precio !== undefined);

// Absoluto y no "#sucursales": este bloque tambien se usa en las paginas de
// sucursal, donde ese ancla no existe y el enlace no llevaria a ninguna parte.
const enlaceSucursales = `${rutaInicio(idioma)}#sucursales`;

/**
 * Una banda por servicio, a ancho completo.
 *
 * Se alterna el fondo y el lado de la foto. El fondo, porque ocho bandas
 * oscuras seguidas convierten la pagina en un muro y el cliente descarto
 * expresamente el negro; el lado, porque ocho bandas identicas se leen como una
 * sola y se deja de mirar a la tercera.
 *
 * La foto va en columna, a su proporcion vertical, y no de fondo a sangre: el
 * material son retratos 3:4 y una banda apaisada les corta la cabeza. Es la
 * misma leccion que el arco de la galeria y que el primer hero de servicio.
 */
// Dos imagenes por servicio. La segunda cuenta algo que la primera no: en la
// mayoria de servicios una es el resultado y otra el trabajo en marcha.
const POR_SERVICIO = 2;

const carta = servicios.map((servicio, indice) => {
  const retratos = retratosDeServicio(servicio.clave, POR_SERVICIO);
  const retrato = retratos[0];
  return {
    servicio,
    retratos,
    retrato,
    oscura: indice % 2 === 1,
    invertida: indice % 2 === 1,
  };
});

// Las dos primeras se ven al llegar a la seccion: esas cargan de entrada.
const CARGA_INMEDIATA = 2;
---

<section id="servicios" class="border-fondo-200 border-t">
  <div class="bg-fondo-50 py-24 md:py-28">
    <div class="mx-auto max-w-6xl px-5">
      <p class="antetitulo">{T.serviciosEtiqueta}</p>
      <h2 class="mt-6 max-w-2xl text-5xl sm:text-6xl md:text-[4.25rem]">
        {T.serviciosTitulo}
      </h2>
      <p class="text-tinta-600 mt-5 max-w-2xl text-lg leading-relaxed">
        {T.serviciosDescripcion}
      </p>
    </div>
  </div>

  <ul>
    {
      carta.map(
        ({ servicio, retratos, retrato, apaisada, oscura, invertida }, indice) => (
          <li class:list={[oscura ? 'bg-salvia-950' : 'bg-fondo-100']}>
            <a href={rutaServicio(idioma, servicio.clave)} class="group block">
              {/* Sin foto, la banda no deja un rectangulo vacio de 700 px: se
                queda en una sola columna y mucho mas baja. Un hueco de ese
                tamano no informa de nada, solo hace bajar. */}
              <div
                class:list={[
                  'mx-auto grid max-w-6xl items-center gap-10 px-5',
                  retrato
                    ? 'py-16 md:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16'
                    : 'py-12 md:py-14',
                ]}
              >
                {/* Par de imagenes. La segunda baja un poco: dos rectangulos
                  alineados se leen como una tabla, y escalonados se leen como
                  un par. Si solo hay una, ocupa el ancho ella sola. */}
                {retratos.length > 0 && (
                  <div
                    class:list={[
                      'grid gap-4',
                      retratos.length > 1 && 'grid-cols-2',
                      invertida && 'lg:order-2',
                    ]}
                  >
                    {retratos.map((imagen, posicion) => (
                      <figure
                        class:list={[
                          'overflow-hidden rounded-2xl border',
                          oscura ? 'border-salvia-800' : 'border-fondo-300',
                          posicion === 1 && 'mt-8 sm:mt-12',
                        ]}
                      >
                        <Image
                          src={imagen}
                          alt=""
                          widths={[300, 600, 900]}
                          sizes="(max-width: 1023px) 46vw, 24vw"
                          loading={
                            indice < CARGA_INMEDIATA && posicion === 0 ? 'eager' : 'lazy'
                          }
                          decoding="async"
                          class:list={[
                            'size-full object-cover transition duration-700 group-hover:scale-[1.03]',
                            apaisada ? 'aspect-[4/3]' : 'aspect-[4/5]',
                          ]}
                        />
                      </figure>
                    ))}
                  </div>
                )}

                <div class={retrato && invertida ? 'lg:order-1' : undefined}>
                  <h3
                    class:list={[
                      'transition',
                      retrato ? 'text-5xl sm:text-6xl' : 'text-4xl sm:text-5xl',
                      oscura
                        ? 'text-fondo-50 group-hover:text-laton-300'
                        : 'text-tinta-900 group-hover:text-salvia-700',
                    ]}
                  >
                    {t(servicio.nombre, idioma)}
                  </h3>

                  <p
                    class:list={[
                      'mt-6 max-w-md text-lg leading-relaxed',
                      oscura ? 'text-fondo-100' : 'text-tinta-600',
                    ]}
                  >
                    {t(servicio.descripcion, idioma)}
                  </p>

                  <dl
                    class:list={[
                      'mt-10 flex flex-wrap items-baseline gap-x-12 gap-y-4 border-t pt-8',
                      oscura ? 'border-salvia-800' : 'border-fondo-300',
                    ]}
                  >
                    <div>
                      <dt
                        class:list={[
                          'font-mono text-[0.7rem] tracking-[0.16em] uppercase',
                          oscura ? 'text-laton-300' : 'text-laton-700',
                        ]}
                      >
                        {moneda.codigo}
                      </dt>
                      <dd
                        class:list={[
                          'mt-2 leading-none',
                          servicio.precio === undefined
                            ? oscura
                              ? 'text-fondo-100 font-mono text-sm'
                              : 'text-tinta-500 font-mono text-sm'
                            : oscura
                              ? 'font-display text-laton-300 text-5xl tabular-nums'
                              : 'font-display text-salvia-500 text-5xl tabular-nums',
                        ]}
                      >
                        {servicio.precio === undefined
                          ? T.consultar
                          : `${servicio.desde ? T.precioDesde + ' ' : ''}$${servicio.precio}`}
                      </dd>
                    </div>

                    {servicio.duracion !== undefined && (
                      <div>
                        <dt
                          class:list={[
                            'font-mono text-[0.7rem] tracking-[0.16em] uppercase',
                            oscura ? 'text-laton-300' : 'text-laton-700',
                          ]}
                        >
                          {T.heroAbrimos}
                        </dt>
                        <dd
                          class:list={[
                            'mt-2 font-mono text-2xl tabular-nums',
                            oscura ? 'text-fondo-50' : 'text-tinta-900',
                          ]}
                        >
                          {rellenar(T.unosMinutos, { n: servicio.duracion })}
                        </dd>
                      </div>
                    )}
                  </dl>

                  <p
                    class:list={[
                      'mt-8 font-mono text-[0.7rem] tracking-[0.16em] uppercase underline underline-offset-8 transition',
                      oscura
                        ? 'text-laton-300 group-hover:text-fondo-50'
                        : 'text-laton-700 group-hover:text-salvia-700',
                    ]}
                  >
                    {servicio.destacado ? T.masPedido : T.verServicio}
                  </p>
                </div>
              </div>
            </a>
          </li>
        ),
      )
    }
  </ul>

  <div class="bg-fondo-50 py-14">
    <p class="text-tinta-500 mx-auto max-w-6xl px-5 text-sm">
      {hayPrecios && `${t(moneda.nota, idioma)} `}{T.serviciosPie}{' '}
      <a
        href={enlaceSucursales}
        class="text-salvia-700 hover:text-salvia-800 font-semibold underline underline-offset-4"
      >
        {T.serviciosPieEnlace}</a
      >.
    </p>
  </div>
</section>
