---
import { servicios, moneda } from '../data/site';
import { idiomaDe, rutaInicio, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';
import TituloSeccion from './TituloSeccion.astro';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

// Si todavia no hay ningun precio cargado no tiene sentido anunciar la moneda.
const hayPrecios = servicios.some((servicio) => servicio.precio !== undefined);

// Absoluto y no "#sucursales": este bloque tambien se usa en las paginas de
// sucursal, donde ese ancla no existe y el enlace no llevaria a ninguna parte.
const enlaceSucursales = `${rutaInicio(idioma)}#sucursales`;
---

<section id="servicios" class="border-fondo-200 border-t py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <TituloSeccion
      etiqueta={T.serviciosEtiqueta}
      titulo={T.serviciosTitulo}
      descripcion={T.serviciosDescripcion}
    />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        servicios.map((servicio) => (
          <li
            class:list={[
              'group relative flex flex-col rounded-2xl border p-7 transition',
              servicio.destacado
                ? 'border-salvia-600/45 bg-salvia-600/[0.06] hover:border-salvia-700'
                : 'border-fondo-300 bg-fondo-100/60 hover:border-fondo-400',
            ]}
          >
            {servicio.destacado && (
              <span class="bg-salvia-600 text-fondo-50 absolute -top-2.5 left-7 rounded-full px-3 py-0.5 text-[0.65rem] font-bold tracking-[0.12em] uppercase">
                {T.masPedido}
              </span>
            )}

            <div class="flex items-start justify-between gap-4">
              <h3 class="text-3xl leading-none">{t(servicio.nombre, idioma)}</h3>
              <p
                class:list={[
                  'shrink-0 leading-none',
                  servicio.precio !== undefined
                    ? 'font-display text-salvia-500 text-3xl'
                    : 'text-tinta-500 text-xs font-semibold tracking-[0.12em] uppercase',
                ]}
              >
                {servicio.precio !== undefined ? `$${servicio.precio}` : T.consultar}
              </p>
            </div>

            <p class="text-tinta-600 mt-4 flex-1 text-sm leading-relaxed">
              {t(servicio.descripcion, idioma)}
            </p>

            {servicio.duracion !== undefined && (
              <p class="text-tinta-500 mt-6 flex items-center gap-2 text-xs font-medium tracking-[0.14em] uppercase">
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" stroke-linecap="round" />
                </svg>
                {rellenar(T.unosMinutos, { n: servicio.duracion })}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <p class="text-tinta-500 mt-10 text-sm">
      {hayPrecios && `${t(moneda.nota, idioma)} `}{T.serviciosPie}{' '}
      <a
        href={enlaceSucursales}
        class="text-salvia-700 hover:text-salvia-800 font-semibold underline underline-offset-4"
      >
        {T.serviciosPieEnlace}</a
      >.
    </p>
  </div>
</section>
