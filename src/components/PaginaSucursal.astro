---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import TarjetaSucursal from './TarjetaSucursal.astro';
import Servicios from './Servicios.astro';
import { negocio, sucursales, type Sucursal } from '../data/site';
import {
  IDIOMAS,
  idiomaDe,
  rutaInicio,
  rutaSucursal,
  t,
  type Idioma,
} from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';
import { esquemaPaginaSucursal } from '../seo/schema';

interface Props {
  sucursal: Sucursal;
}

const { sucursal } = Astro.props;

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

const rutas = Object.fromEntries(
  IDIOMAS.map((otro) => [otro, rutaSucursal(otro, sucursal.id)]),
) as Record<Idioma, string>;

// El titulo lleva la colonia: es lo que se busca cuando alguien quiere una
// barberia "cerca", y es lo que diferencia esta pagina de la otra sucursal.
const encabezado = rellenar(T.sucursalH1, { colonia: sucursal.direccion.colonia });
const titulo = encabezado;
const descripcion =
  idioma === 'en'
    ? `${negocio.nombre} in ${sucursal.direccion.colonia}, ${sucursal.direccion.ciudad}. ${t(sucursal.direccion.referencia, idioma)}. Call ${sucursal.telefono}.`
    : `${negocio.nombre} en ${sucursal.direccion.colonia}, ${sucursal.direccion.ciudad}. ${t(sucursal.direccion.referencia, idioma)}. Telefono ${sucursal.telefono}.`;

const datosEstructurados = esquemaPaginaSucursal(
  sucursal,
  idioma,
  new URL(Astro.url.pathname, Astro.site),
  rutaInicio(idioma),
  T.sucursalesEtiqueta,
);

const otras = sucursales.filter((otra) => otra.id !== sucursal.id);
---

<Layout
  titulo={titulo}
  descripcion={descripcion}
  rutas={rutas}
  datosEstructurados={datosEstructurados}
>
  <Header rutas={rutas} />

  <main id="contenido" class="pt-20">
    <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
      <!-- Miga de pan visible. La equivalente en datos estructurados la emite
           el esquema de la pagina. -->
      <nav aria-label={T.sucursalesEtiqueta} class="text-tinta-500 text-sm">
        <a href={rutaInicio(idioma)} class="hover:text-salvia-700 transition">
          {negocio.nombre}
        </a>
        <span aria-hidden="true"> / </span>
        <a
          href={`${rutaInicio(idioma)}#sucursales`}
          class="hover:text-salvia-700 transition"
        >
          {T.sucursalesEtiqueta}
        </a>
        <span aria-hidden="true"> / </span>
        <span class="text-tinta-700">{sucursal.nombre}</span>
      </nav>

      <div class="mt-8">
        <p class="text-salvia-600 text-xs font-semibold tracking-[0.22em] uppercase">
          {
            rellenar(T.sucursalAntetitulo, {
              nombre: sucursal.nombre,
              ciudad: sucursal.direccion.ciudad,
            })
          }
        </p>
        <h1 class="mt-3 text-5xl leading-[0.95] sm:text-6xl">{encabezado}</h1>
      </div>

      <div class="mt-10">
        <TarjetaSucursal sucursal={sucursal} conEnlace={false} encabezado="h2" />
      </div>

      {
        /* La lista de servicios va tambien aqui: sin ella la pagina se queda en
          menos de 200 palabras, que es poco para competir por su colonia, y
          ademas quien entra buscando esta sucursal quiere saber que se hace. */
      }
    </div>

    <Servicios />

    <div class="mx-auto max-w-6xl px-5 pb-16 md:pb-24">
      {
        otras.length > 0 && (
          <section class="mt-16">
            <h2 class="text-3xl leading-none">{T.otraSucursal}</h2>
            <ul class="mt-6 flex flex-wrap gap-3">
              {otras.map((otra) => (
                <li>
                  <a
                    href={rutaSucursal(idioma, otra.id)}
                    class="border-fondo-300 bg-fondo-100/60 hover:border-salvia-600 inline-flex flex-col rounded-2xl border px-6 py-4 transition"
                  >
                    <span class="font-display text-tinta-900 text-2xl leading-none">
                      {otra.nombre}
                    </span>
                    <span class="text-tinta-500 mt-1 text-sm">
                      {otra.direccion.colonia}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <a
        href={rutaInicio(idioma)}
        class="text-salvia-700 hover:text-salvia-800 mt-12 inline-flex items-center gap-2 text-sm font-semibold underline underline-offset-4 transition"
      >
        {T.volverAlInicio}
      </a>
    </div>
  </main>

  <Footer />
</Layout>
