---
import { Image, getImage } from 'astro:assets';
import type { MedioGaleria } from '../data/site';
import { idiomaDe, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';

interface Props {
  medios: MedioGaleria[];
  /** Nombre de la region para lectores de pantalla. */
  etiqueta: string;
  /**
   * Filtros por servicio. Se omiten si no hay al menos dos categorias con
   * material: un solo filtro no filtra nada.
   */
  filtros?: { clave: string; etiqueta: string }[];
}

const { medios, etiqueta, filtros = [] } = Astro.props;

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

// Anchos de cada diapositiva, en el mismo orden que los puntos de corte de
// abajo. Se declara una sola vez porque el `sizes` de las imagenes tiene que
// coincidir con el ancho real o el navegador descarga el tamano equivocado.
const TAMANOS = '(max-width: 639px) 78vw, (max-width: 1023px) 46vw, 31vw';

// En escritorio se ven tres tarjetas a la vez: esas se cargan de entrada y el
// resto espera a que se deslice. Confiar solo en loading="lazy" para las que ya
// estan en pantalla deja huecos en blanco al abrir la pagina.
//
// En los videos esto marca la diferencia en Safari, que con preload="none"
// arranca completamente en frio: los primeros piden solo la cabecera (unos
// pocos kB) para poder empezar a reproducir en cuanto entran en pantalla.
const CARGA_INMEDIATA = 3;

// El poster del video se optimiza igual que una foto. Sin esto se serviria el
// JPG original, que es justo lo que estamos evitando con el resto.
const preparados = await Promise.all(
  medios.map(async (medio) => {
    if (medio.tipo !== 'video') return { medio, poster: null };
    const poster = await getImage({ src: medio.poster, width: 800, format: 'webp' });
    return { medio, poster: poster.src };
  }),
);
---

<div class="relative" data-carrusel>
  <!-- Los filtros nacen ocultos y los muestra el script. Sin JavaScript no
       filtrarian nada, y un boton que no hace nada es peor que no tenerlo: asi
       quien llegue sin JavaScript ve la galeria entera, que es el estado util. -->
  {
    filtros.length > 1 && (
      <div
        data-filtros
        hidden
        role="group"
        aria-label={T.galeriaFiltrar}
        class="mb-8 flex flex-wrap gap-2"
      >
        <button
          type="button"
          data-filtro
          data-clave=""
          aria-pressed="true"
          class="border-fondo-400 text-tinta-700 hover:border-salvia-600 hover:text-salvia-700 aria-pressed:border-salvia-600 aria-pressed:bg-salvia-600 aria-pressed:text-fondo-50 rounded-full border px-4 py-1.5 font-mono text-[0.68rem] tracking-[0.08em] uppercase transition"
        >
          {T.galeriaTodo}
        </button>
        {filtros.map((filtro) => (
          <button
            type="button"
            data-filtro
            data-clave={filtro.clave}
            aria-pressed="false"
            class="border-fondo-400 text-tinta-700 hover:border-salvia-600 hover:text-salvia-700 aria-pressed:border-salvia-600 aria-pressed:bg-salvia-600 aria-pressed:text-fondo-50 rounded-full border px-4 py-1.5 font-mono text-[0.68rem] tracking-[0.08em] uppercase transition"
          >
            {filtro.etiqueta}
          </button>
        ))}
      </div>
    )
  }

  <!-- La pista es la que hace el scroll. Es enfocable para que se pueda
       recorrer con el teclado sin depender de las flechas.

       Las diapositivas usan snap-start y no snap-center: con varias tarjetas a
       la vista, la "actual" es la primera visible, los puntos se corresponden
       con lo que se ve, y ni la primera ni la ultima quedan a medias. -->
  <ul
    data-pista
    tabindex="0"
    role="region"
    aria-label={etiqueta}
    class="flex snap-x snap-mandatory [scrollbar-width:none] gap-4 overflow-x-auto overscroll-x-contain scroll-smooth pb-2 [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
  >
    {
      preparados.map(({ medio, poster }, indice) => (
        <li
          data-slide
          data-servicio={medio.servicio ?? ''}
          data-tipo={medio.tipo}
          class="w-[78%] shrink-0 snap-start sm:w-[46%] lg:w-[31%]"
        >
          {/* Esquinas normales y no en arco: el material son retratos
              verticales, y un arco arriba recorta la cabeza. El guino al local
              se queda en el color de las bandas de seccion. */}
          <figure class="border-fondo-300 bg-fondo-150 relative aspect-[4/5] overflow-hidden rounded-2xl border">
            {medio.tipo === 'foto' ? (
              <Image
                src={medio.src}
                alt={t(medio.alt, idioma)}
                widths={[400, 800, 1200]}
                sizes={TAMANOS}
                loading={indice < CARGA_INMEDIATA ? 'eager' : 'lazy'}
                decoding="async"
                class="size-full object-cover"
              />
            ) : (
              <>
                <video
                  data-video
                  class="size-full rounded-2xl object-cover"
                  poster={poster ?? undefined}
                  aria-label={t(medio.alt, idioma)}
                  muted
                  loop
                  playsinline
                  preload={indice < CARGA_INMEDIATA ? 'metadata' : 'none'}
                >
                  {medio.webm && <source src={medio.webm} type="video/webm" />}
                  <source src={medio.mp4} type="video/mp4" />
                </video>

                <span class="bg-fondo-50/80 text-tinta-900 pointer-events-none absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-mono text-[0.62rem] tracking-[0.12em] uppercase backdrop-blur-sm">
                  <svg
                    class="size-3"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M8 5v14l11-7z" />
                  </svg>
                  {T.video}
                </span>
              </>
            )}
          </figure>
        </li>
      ))
    }
  </ul>

  <!-- Flechas: solo en pantallas con raton. En tactil sobra, se desliza. -->
  <button
    type="button"
    data-anterior
    aria-label={T.anterior}
    class="border-fondo-400 bg-fondo-50/90 text-tinta-900 hover:border-salvia-600 hover:text-salvia-700 absolute top-1/2 -left-4 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full border backdrop-blur-sm transition disabled:pointer-events-none disabled:opacity-0 lg:flex"
  >
    <svg
      class="size-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 6l-6 6 6 6"></path>
    </svg>
  </button>

  <button
    type="button"
    data-siguiente
    aria-label={T.siguiente}
    class="border-fondo-400 bg-fondo-50/90 text-tinta-900 hover:border-salvia-600 hover:text-salvia-700 absolute top-1/2 -right-4 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full border backdrop-blur-sm transition disabled:pointer-events-none disabled:opacity-0 lg:flex"
  >
    <svg
      class="size-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 6l6 6-6 6"></path>
    </svg>
  </button>

  <!-- Las plantillas viajan en el HTML porque al filtrar hay que rehacer las
       etiquetas de los puntos, y el script no tiene acceso al diccionario. -->
  <ol
    data-puntos
    data-plantilla-foto={T.irALaFoto}
    data-plantilla-video={T.irAlVideo}
    class="mt-6 flex flex-wrap justify-center gap-2.5"
    aria-label={T.irAElemento}
  >
    {
      medios.map((medio, indice) => (
        <li>
          <button
            type="button"
            data-punto
            data-indice={indice}
            aria-label={rellenar(medio.tipo === 'video' ? T.irAlVideo : T.irALaFoto, {
              n: indice + 1,
              total: medios.length,
            })}
            class="bg-fondo-400 hover:bg-tinta-500 aria-[current=true]:bg-salvia-600 block h-2 w-2 rounded-full transition-all aria-[current=true]:w-6"
          />
        </li>
      ))
    }
  </ol>
</div>

<script>
  const REDUCIR = window.matchMedia('(prefers-reduced-motion: reduce)');

  function iniciar(carrusel: HTMLElement) {
    const pista = carrusel.querySelector<HTMLElement>('[data-pista]');
    const todos = [...carrusel.querySelectorAll<HTMLElement>('[data-slide]')];
    // Las que el filtro actual deja a la vista. Se reasigna al filtrar, y todo
    // lo demas —puntos, flechas, teclado, anclaje— lee de aqui, asi que no hay
    // un segundo sitio donde se pueda quedar desincronizado.
    let slides = todos;
    const puntos = [...carrusel.querySelectorAll<HTMLButtonElement>('[data-punto]')];
    const anterior = carrusel.querySelector<HTMLButtonElement>('[data-anterior]');
    const siguiente = carrusel.querySelector<HTMLButtonElement>('[data-siguiente]');
    if (!pista || slides.length === 0) return;

    /** Cuantas diapositivas caben a la vez en la pista. */
    const visibles = () => {
      const ancho = slides[0]!.getBoundingClientRect().width;
      const hueco = parseFloat(getComputedStyle(pista).columnGap) || 0;
      return Math.max(1, Math.round((pista.clientWidth + hueco) / (ancho + hueco)));
    };

    /**
     * Ultima diapositiva que puede llegar a quedar pegada al borde izquierdo.
     * Con 7 tarjetas y 3 a la vista, la pista se acaba con la 4 arriba: las dos
     * ultimas nunca son "la actual", asi que sus puntos sobran.
     */
    const ultimoAlcanzable = () => Math.max(0, slides.length - visibles());

    /**
     * La activa es la primera visible, la que queda pegada al borde izquierdo
     * por el snap-start. Dividir el scroll entre el ancho de una diapositiva no
     * vale: los topes del contenedor hacen que las posiciones de anclado no
     * sean multiplos exactos.
     */
    const indiceActual = () => {
      if (pista.scrollLeft >= pista.scrollWidth - pista.clientWidth - 1) {
        return ultimoAlcanzable();
      }

      const izquierda = pista.getBoundingClientRect().left;

      let mejor = 0;
      let menorDistancia = Infinity;

      slides.forEach((slide, i) => {
        const distancia = Math.abs(slide.getBoundingClientRect().left - izquierda);
        if (distancia < menorDistancia) {
          menorDistancia = distancia;
          mejor = i;
        }
      });

      return mejor;
    };

    // Arrow y no `function`: en una declaracion hoisted TypeScript pierde el
    // estrechamiento de `pista` que hizo la guarda de arriba.
    const pintarEstado = () => {
      const indice = indiceActual();
      const tope = ultimoAlcanzable();

      puntos.forEach((punto, i) => {
        // aria-current en vez de una clase: el estado tambien llega a quien usa
        // lector de pantalla, y el CSS se cuelga del mismo atributo.
        punto.setAttribute('aria-current', String(i === indice));
        // Sin JS se ven todos y todos funcionan; en cuanto sabemos cuantas
        // caben, se ocultan los que no pueden llegar a ser la actual.
        if (punto.parentElement) punto.parentElement.hidden = i > tope;
      });

      // Margen de un pixel: el scroll rara vez cae en el valor exacto.
      const fin = pista.scrollWidth - pista.clientWidth - 1;
      if (anterior) anterior.disabled = pista.scrollLeft <= 1;
      if (siguiente) siguiente.disabled = pista.scrollLeft >= fin;
    };

    // scrollIntoView y no scrollTo: deja que el navegador calcule la posicion
    // y respeta los topes del contenedor sin replicar ese calculo a mano.
    // block:"nearest" evita que la pagina salte en vertical.
    //
    // Es `let` porque con el carrusel anclado hay que navegar de otra forma:
    // mover la pista a mano no vale, el scrub la devuelve en el siguiente
    // fotograma. mejorarConGsap sustituye esta funcion por una que mueve el
    // scroll de la pagina, que es lo que de verdad manda entonces.
    let irA = (indice: number) => {
      const destino = slides[Math.max(0, Math.min(indice, slides.length - 1))];
      destino?.scrollIntoView({
        behavior: REDUCIR.matches ? 'auto' : 'smooth',
        inline: 'start',
        block: 'nearest',
      });
    };

    anterior?.addEventListener('click', () => irA(indiceActual() - 1));
    siguiente?.addEventListener('click', () => irA(indiceActual() + 1));
    puntos.forEach((punto, i) => punto.addEventListener('click', () => irA(i)));

    let pendiente = false;
    pista.addEventListener(
      'scroll',
      () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(() => {
          pintarEstado();
          pendiente = false;
        });
      },
      { passive: true },
    );

    window.addEventListener('resize', pintarEstado, { passive: true });
    pintarEstado();

    reproducirSoloVisible(pista);

    // Se rellena si el anclaje llega a activarse. Filtrar cambia el ancho de la
    // pista, y con el el recorrido que ScrollTrigger tiene calculado.
    let refrescarAnclaje = () => {};

    anclarConGsap(carrusel, pista, () => slides, ultimoAlcanzable).then((anclado) => {
      if (!anclado) return;
      irA = anclado.navegar;
      refrescarAnclaje = anclado.refrescar;
      pintarEstado();
    });

    // --- Filtros por servicio ---------------------------------------------

    const barra = carrusel.querySelector<HTMLElement>('[data-filtros]');
    const botones = [...carrusel.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
    const lista = carrusel.querySelector<HTMLElement>('[data-puntos]');

    /**
     * Al filtrar, el punto numero 3 deja de ser la tercera pieza de la galeria
     * y pasa a ser la tercera de lo que se ve. Si no se rehace la etiqueta,
     * quien va con lector de pantalla oye un total que ya no existe.
     */
    const etiquetarPuntos = () => {
      const plantillas = {
        foto: lista?.dataset.plantillaFoto ?? '',
        video: lista?.dataset.plantillaVideo ?? '',
      };

      puntos.forEach((punto, i) => {
        const slide = slides[i];
        if (!slide) return;
        const plantilla =
          slide.dataset.tipo === 'video' ? plantillas.video : plantillas.foto;
        punto.setAttribute(
          'aria-label',
          plantilla
            .replace('{n}', String(i + 1))
            .replace('{total}', String(slides.length)),
        );
      });
    };

    const filtrar = (clave: string) => {
      todos.forEach((slide) => {
        slide.hidden = clave !== '' && (slide.dataset.servicio ?? '') !== clave;
      });
      slides = todos.filter((slide) => !slide.hidden);

      botones.forEach((boton) =>
        boton.setAttribute('aria-pressed', String((boton.dataset.clave ?? '') === clave)),
      );

      etiquetarPuntos();
      pista.scrollLeft = 0;
      pintarEstado();
      refrescarAnclaje();
    };

    if (barra) {
      barra.hidden = false;
      botones.forEach((boton) =>
        boton.addEventListener('click', () => filtrar(boton.dataset.clave ?? '')),
      );
    }
  }

  /**
   * Solo se reproduce el video que esta a la vista, y de uno en uno. Con
   * preload="none" en el HTML, un video que nunca se ve no descarga ni un byte.
   */
  function reproducirSoloVisible(pista: HTMLElement) {
    const videos = [...pista.querySelectorAll<HTMLVideoElement>('[data-video]')];
    if (videos.length === 0) return;

    // Con movimiento reducido no se reproduce nada solo: se dan los controles
    // para que cada quien decida.
    if (REDUCIR.matches) {
      videos.forEach((video) => {
        video.controls = true;
        video.preload = 'metadata';
      });
      return;
    }

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          const video = entrada.target as HTMLVideoElement;
          if (entrada.isIntersecting) {
            video.preload = 'auto';
            // Si el archivo no existe, play() rechaza: no es motivo para
            // romper nada, simplemente se queda el poster.
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { root: pista, threshold: 0.6 },
    );

    videos.forEach((video) => observador.observe(video));
  }

  /**
   * Mejora progresiva: la seccion se ancla y el scroll vertical se convierte en
   * avance horizontal del carrusel.
   *
   * Solo en escritorio con raton. En tactil anclar pelea con el gesto nativo de
   * desplazar, que ahi ya funciona bien, asi que el movil ni descarga GSAP. Con
   * "prefers-reduced-motion" tampoco: secuestrar el scroll es justo lo que esa
   * preferencia pide evitar.
   *
   * Devuelve con que navegar mientras esta anclado y con que recalcularlo
   * cuando cambia el contenido de la pista, o null si no se activo.
   *
   * Las diapositivas llegan como funcion y no como lista: el filtro las cambia
   * despues de esta llamada, y una lista capturada aqui se quedaria vieja.
   */
  async function anclarConGsap(
    carrusel: HTMLElement,
    pista: HTMLElement,
    verSlides: () => HTMLElement[],
    ultimoAlcanzable: () => number,
  ) {
    const enEscritorio = window.matchMedia('(min-width: 1024px) and (pointer: fine)');
    if (!enEscritorio.matches || REDUCIR.matches) return null;

    const seccion = carrusel.closest('section');
    if (!seccion) return null;

    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);

    gsap.registerPlugin(ScrollTrigger);

    /** Lo que le queda por recorrer a la pista de un extremo al otro. */
    const recorrido = () => pista.scrollWidth - pista.clientWidth;
    if (recorrido() <= 0) return null;

    /**
     * Cuanto scroll vertical cuesta atravesar la galeria.
     *
     * Lo natural seria uno a uno con el recorrido horizontal, y asi estaba
     * cuando habia diez piezas. Con treinta y cinco son casi doce mil pixeles:
     * trece pantallas de scroll para pasar de largo una seccion. Pasado el tope
     * el avance horizontal va mas rapido que el dedo, que se nota, pero se nota
     * bastante menos que quedarse atrapado en el camino a las sucursales.
     */
    const TOPE_PANTALLAS = 3;
    const recorridoVertical = () =>
      Math.min(recorrido(), window.innerHeight * TOPE_PANTALLAS);

    // Anclar una seccion mas alta que la ventana deja parte fuera de vista todo
    // el rato. Primero se le quita aire vertical, que es de donde se puede
    // recortar sin tocar el contenido, y si aun asi no cabe se renuncia al
    // efecto y se deja el scroll normal, que nunca estorba.
    //
    // Va en estilo en linea y no con una clase: en Tailwind las utilidades
    // pesan mas que la capa de componentes, asi que un `py-32` en el HTML
    // ganaria a cualquier regla que escribieramos.
    const espaciadoOriginal = {
      arriba: seccion.style.paddingTop,
      abajo: seccion.style.paddingBottom,
    };
    seccion.style.paddingTop = '2.5rem';
    seccion.style.paddingBottom = '2.5rem';

    if (seccion.getBoundingClientRect().height > window.innerHeight) {
      seccion.style.paddingTop = espaciadoOriginal.arriba;
      seccion.style.paddingBottom = espaciadoOriginal.abajo;
      return null;
    }

    // Se mueve el scrollLeft real y no un transform sobre la pista. Un
    // transform deja scrollWidth === clientWidth, y con eso se caen las
    // flechas, los puntos, el teclado y el observador que reproduce el video
    // visible. Moviendo el scroll nativo, todo eso sigue funcionando igual.
    //
    // El anclado obligatorio hay que quitarlo: reengancha la pista en cada
    // fotograma y el avance sale a tirones.
    pista.style.scrollSnapType = 'none';
    // La pista lleva scroll-smooth para las flechas. Durante el anclaje estorba:
    // cada asignacion de scrollLeft se animaria, y como el scrub asigna en cada
    // fotograma, el avance saldria a rastras.
    pista.style.scrollBehavior = 'auto';

    const anclaje = ScrollTrigger.create({
      trigger: seccion,
      start: 'top top',
      end: () => '+=' + recorridoVertical(),
      pin: true,
      // Un pelin de scrub suaviza el paso sin llegar a sentirse a la deriva.
      scrub: 0.5,
      // Sin esto, al cambiar el tamano de la ventana el final se queda con el
      // recorrido viejo y la ultima tarjeta no llega a verse.
      invalidateOnRefresh: true,
      anticipatePin: 1,
      onUpdate: (self) => {
        pista.scrollLeft = self.progress * recorrido();
      },
    });

    // Con el carrusel anclado, las flechas y los puntos tienen que mover la
    // pagina, no la pista: la posicion horizontal es un reflejo del scroll
    // vertical, asi que es ahi donde hay que actuar.
    const navegar = (indice: number) => {
      const slides = verSlides();
      const destino = Math.max(0, Math.min(indice, ultimoAlcanzable()));
      const primera = slides[0];
      const hasta = slides[destino];
      if (!primera || !hasta) return;

      const progreso = Math.min(
        1,
        Math.max(0, (hasta.offsetLeft - primera.offsetLeft) / recorrido()),
      );

      window.scrollTo({
        top: anclaje.start + progreso * (anclaje.end - anclaje.start),
        behavior: 'smooth',
      });
    };

    /**
     * Con un filtro puesto puede que ya no sobre pista que recorrer. Anclar
     * entonces dejaria la seccion pegada sin nada que avanzar, asi que el
     * anclaje se apaga y se vuelve a encender segun de cuanto material haya.
     */
    const refrescar = () => {
      if (recorrido() <= 0) {
        anclaje.disable(true);
        return;
      }
      anclaje.enable();
      ScrollTrigger.refresh();
    };

    return { navegar, refrescar };
  }

  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach(iniciar);
</script>
