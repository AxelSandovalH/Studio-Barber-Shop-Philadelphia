---
interface Props {
  etiqueta: string;
  titulo: string;
  descripcion?: string;
  /** Centra el bloque. Por defecto se alinea a la izquierda. */
  centrado?: boolean;
}

const { etiqueta, titulo, descripcion, centrado = false } = Astro.props;
---

<div class={centrado ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'}>
  <p class:list={['antetitulo', centrado && 'justify-center']}>{etiqueta}</p>
  <h2 class="mt-6 text-5xl sm:text-6xl md:text-[4.25rem]">{titulo}</h2>
  {
    descripcion && (
      <p class="text-tinta-600 mt-5 text-lg leading-relaxed">{descripcion}</p>
    )
  }
</div>
