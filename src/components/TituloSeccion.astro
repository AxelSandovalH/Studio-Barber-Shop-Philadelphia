---
interface Props {
  etiqueta: string;
  titulo: string;
  descripcion?: string;
  /** Centra el bloque. Por defecto se alinea a la izquierda. */
  centrado?: boolean;
}

const { etiqueta, titulo, descripcion, centrado = false } = Astro.props;
---

<div class={centrado ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'}>
  <p class="text-laton-500 text-xs font-semibold tracking-[0.22em] uppercase">
    {etiqueta}
  </p>
  <h2 class="mt-4 text-5xl leading-[0.95] sm:text-6xl">{titulo}</h2>
  {
    descripcion && (
      <p class="text-hueso-300 mt-5 text-lg leading-relaxed">{descripcion}</p>
    )
  }
</div>
