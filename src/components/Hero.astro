---
import { getImage } from 'astro:assets';
import { negocio, sucursales } from '../data/site';
import { idiomaDe, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';
import marPoster from '../assets/portada/mar-rocas-poster.jpg';

// El poster se optimiza como cualquier foto. Es lo que se ve mientras el video
// no arranca, y en movil y con movimiento reducido es lo unico que se ve.
const poster = await getImage({ src: marPoster, width: 1600, format: 'webp' });

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

// Las cifras salen de los datos para que no se queden desfasadas.
const principal = sucursales[0]!;
const diasAbiertos = principal.horarios
  .filter((franja) => !franja.cerrado)
  .reduce((total, franja) => total + franja.indices.length, 0);
---

<section id="inicio" class="relative overflow-hidden pt-20">
  <!-- Fondo: el mar de Cabo, grabado en el Medano. Es contexto, no la
       propuesta: encima va un velo crema para que el texto se lea sobre la
       misma paleta clara de siempre y el mar solo asome por la derecha. -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <video
      data-video-portada
      class="size-full object-cover"
      poster={poster.src}
      muted
      loop
      playsinline
      preload="none"
    >
      <source src="/portada/mar-rocas.mp4" type="video/mp4" />
    </video>

    <!-- En escritorio el velo se abre hacia la derecha, que es donde no hay
         texto, y el mar se ve. En movil el texto ocupa todo el ancho, asi que
         un degradado lateral no protege nada: ahi se cierra casi del todo y el
         mar queda como textura de fondo. -->
    <div
      class="from-fondo-50/97 via-fondo-50/88 to-fondo-50/72 md:from-fondo-50/94 md:via-fondo-50/72 md:to-fondo-50/12 absolute inset-0 bg-gradient-to-r"
    >
    </div>
    <div
      class="from-fondo-50 absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t to-transparent"
    >
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 py-20 md:py-32">
    <div class="max-w-3xl">
      <p class="antetitulo">{rellenar(T.heroAntetitulo, { n: sucursales.length })}</p>

      <h1 class="mt-8 text-6xl sm:text-7xl md:text-[5.5rem]">
        {T.heroH1}
      </h1>

      {/* El eslogan en cursiva: es la voz de la marca, no un segundo titular. */}
      <p class="font-display text-salvia-500 mt-6 text-3xl italic sm:text-4xl">
        {t(negocio.eslogan, idioma)}
      </p>

      {
        /* Un paso mas oscuro que en el resto del sitio: aqui el texto no cae
          sobre crema plana sino sobre el mar, y con el velo abierto tinta-600
          se quedaba por debajo del contraste minimo. */
      }
      <p class="text-tinta-700 mt-7 max-w-xl text-lg leading-relaxed">
        {t(negocio.descripcion, idioma)}
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#sucursales"
          class="bg-salvia-600 text-fondo-50 hover:bg-salvia-700 inline-flex items-center justify-center gap-2.5 rounded-full px-8 py-4 font-semibold transition"
        >
          {T.agendarCita}
        </a>
        <a
          href="#servicios"
          class="border-fondo-400 text-tinta-900 hover:border-salvia-600 hover:text-salvia-700 inline-flex items-center justify-center gap-2.5 rounded-full border px-8 py-4 font-semibold transition"
        >
          {T.verServicios}
        </a>
      </div>

      <!-- Valores cortos a proposito: las tres columnas tienen que caber en
           un movil estrecho sin partir palabras. -->
      <dl class="mt-14 grid max-w-sm grid-cols-2 gap-6">
        <div>
          <dt class="text-laton-700 font-mono text-[0.7rem] tracking-[0.16em] uppercase">
            {T.heroSucursales}
          </dt>
          <dd class="text-tinta-900 mt-2 font-mono text-2xl tabular-nums">
            {sucursales.length}
          </dd>
        </div>
        <div>
          <dt class="text-laton-700 font-mono text-[0.7rem] tracking-[0.16em] uppercase">
            {T.heroAbrimos}
          </dt>
          <dd class="text-tinta-900 mt-2 font-mono text-2xl tabular-nums">
            {`${diasAbiertos} ${T.heroDias}`}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<script>
  // El video de la portada es decorativo y solo se descarga cuando aporta algo.
  // Se queda en el poster —ya pintado y sin coste extra— en tres casos:
  //
  //   - En movil, donde el velo esta casi cerrado para que el texto se lea a
  //     todo el ancho: se verian dos apuntes de ola a cambio de megas.
  //   - Con "prefers-reduced-motion", porque animar el fondo es justo lo que
  //     esa preferencia pide evitar.
  //   - Con el ahorro de datos activado.
  const video = document.querySelector<HTMLVideoElement>('[data-video-portada]');

  if (video) {
    const escritorio = window.matchMedia('(min-width: 768px)');
    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)');
    const conexion = (navigator as Navigator & { connection?: { saveData?: boolean } })
      .connection;

    const revisar = () => {
      if (!escritorio.matches || reducir.matches || conexion?.saveData) {
        video.pause();
        return;
      }

      video.preload = 'auto';
      // Si el archivo no esta, play() rechaza: se queda el poster y ya.
      video.play().catch(() => {});
    };

    // Se reevalua al cambiar el ancho o la preferencia: quien carga la pagina
    // en una ventana estrecha y luego la maximiza tambien merece el video, y
    // quien activa el movimiento reducido merece que se pare al momento.
    escritorio.addEventListener('change', revisar);
    reducir.addEventListener('change', revisar);
    revisar();
  }
</script>
