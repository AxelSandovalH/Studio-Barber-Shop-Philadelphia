---
import { negocio, sucursales } from '../data/site';
import { idiomaDe, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

// Las cifras salen de los datos para que no se queden desfasadas.
const principal = sucursales[0]!;
const diasAbiertos = principal.horarios
  .filter((franja) => !franja.cerrado)
  .reduce((total, franja) => total + franja.indices.length, 0);
---

<section id="inicio" class="relative overflow-hidden pt-20">
  <!-- Fondo: destello calido arriba a la izquierda y rejilla tenue de barberia. -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="bg-salvia-600/15 absolute -top-40 -left-40 size-[38rem] rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: linear-gradient(var(--color-tinta-900) 1px, transparent 1px), linear-gradient(90deg, var(--color-tinta-900) 1px, transparent 1px); background-size: 72px 72px;"
    >
    </div>
    <div
      class="from-fondo-50 absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t to-transparent"
    >
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 py-20 md:py-32">
    <div class="max-w-3xl">
      <p
        class="border-salvia-600/30 bg-salvia-600/8 text-salvia-700 inline-flex items-center gap-2.5 rounded-full border px-4 py-1.5 text-xs font-semibold tracking-[0.18em] uppercase"
      >
        <span class="bg-salvia-700 size-1.5 rounded-full"></span>
        {rellenar(T.heroAntetitulo, { ano: negocio.desde, n: sucursales.length })}
      </p>

      <h1 class="mt-7 text-6xl leading-[0.92] sm:text-7xl md:text-8xl">
        {T.heroH1}
      </h1>

      <p class="font-display text-salvia-700 mt-6 text-3xl leading-none sm:text-4xl">
        {t(negocio.eslogan, idioma)}
      </p>

      <p class="text-tinta-600 mt-7 max-w-xl text-lg leading-relaxed">
        {t(negocio.descripcion, idioma)}
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#sucursales"
          class="bg-salvia-600 text-fondo-50 hover:bg-salvia-700 inline-flex items-center justify-center gap-2.5 rounded-full px-8 py-4 font-semibold transition"
        >
          {T.agendarCita}
        </a>
        <a
          href="#servicios"
          class="border-fondo-400 text-tinta-900 hover:border-salvia-600 hover:text-salvia-700 inline-flex items-center justify-center gap-2.5 rounded-full border px-8 py-4 font-semibold transition"
        >
          {T.verServicios}
        </a>
      </div>

      <!-- Valores cortos a proposito: las tres columnas tienen que caber en
           un movil estrecho sin partir palabras. -->
      <dl class="mt-14 grid max-w-lg grid-cols-3 gap-6">
        <div>
          <dt class="text-tinta-500 text-xs tracking-[0.14em] uppercase">
            {T.heroSucursales}
          </dt>
          <dd class="font-display text-tinta-900 mt-1.5 text-2xl sm:text-3xl">
            {sucursales.length}
          </dd>
        </div>
        <div>
          <dt class="text-tinta-500 text-xs tracking-[0.14em] uppercase">
            {T.heroAbrimos}
          </dt>
          <dd class="font-display text-tinta-900 mt-1.5 text-2xl sm:text-3xl">
            {diasAbiertos}
            {T.heroDias}
          </dd>
        </div>
        <div>
          <dt class="text-tinta-500 text-xs tracking-[0.14em] uppercase">
            {T.heroDesde}
          </dt>
          <dd class="font-display text-tinta-900 mt-1.5 text-2xl sm:text-3xl">
            {negocio.desde}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
