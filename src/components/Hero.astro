---
import { getImage } from 'astro:assets';
import { negocio, sucursales } from '../data/site';
import { idiomaDe, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';
import marPoster from '../assets/portada/mar-rocas-poster.jpg';

// El poster se optimiza como cualquier foto. Es lo que se ve mientras el video
// no arranca, y en movil y con movimiento reducido es lo unico que se ve.
const poster = await getImage({ src: marPoster, width: 1600, format: 'webp' });

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

// Las cifras salen de los datos para que no se queden desfasadas.
const principal = sucursales[0]!;
const diasAbiertos = principal.horarios
  .filter((franja) => !franja.cerrado)
  .reduce((total, franja) => total + franja.indices.length, 0);
---

{
  /* Portada a sangre: la imagen ocupa la pantalla y el texto va centrado
    encima. 92vh y no 100vh a proposito: que asome el borde de la seccion
    siguiente es lo que dice que la pagina continua. */
}
<section
  id="inicio"
  class="relative flex min-h-[92vh] items-center justify-center overflow-hidden"
>
  <div class="absolute inset-0" aria-hidden="true">
    <video
      data-video-portada
      class="size-full object-cover"
      poster={poster.src}
      muted
      loop
      playsinline
      preload="none"
    >
      <source src="/portada/mar-rocas.mp4" type="video/mp4" />
    </video>

    {
      /* El velo es el verde de marca llevado al fondo de la escala, no un
        negro: el cliente descarto el negro y asi la foto sigue dentro de la
        paleta. El degradado vertical carga arriba, donde va la cabecera, y
        abajo, donde el texto blanco se cruza con la arena clara. */
    }
    <div class="bg-salvia-950/62 absolute inset-0"></div>
    <div
      class="from-salvia-950/75 to-salvia-950/85 absolute inset-0 bg-gradient-to-b via-transparent"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-3xl px-5 py-32 text-center">
    <p class="antetitulo antetitulo-claro justify-center">
      {rellenar(T.heroAntetitulo, { n: sucursales.length })}
    </p>

    <h1 class="text-fondo-50 mt-8 text-5xl sm:text-6xl md:text-7xl">
      {T.heroH1}
    </h1>

    <p class="font-display text-pared-200 mt-6 text-2xl italic sm:text-3xl">
      {t(negocio.eslogan, idioma)}
    </p>

    <p class="text-fondo-100 mx-auto mt-8 max-w-xl leading-relaxed">
      {t(negocio.descripcion, idioma)}
    </p>

    {
      /* Un boton principal, como en las barberias que se ven bien: la accion
        que importa es agendar, y darle un segundo boton del mismo peso la
        diluye. El de servicios va debajo, como enlace. */
    }
    <div class="mt-11 flex flex-col items-center gap-6">
      <a
        href="#sucursales"
        class="bg-fondo-50 text-salvia-700 hover:bg-fondo-150 inline-flex items-center justify-center rounded-full px-10 py-4 font-semibold transition"
      >
        {T.agendarCita}
      </a>

      <a
        href="#servicios"
        class="text-fondo-100 hover:text-fondo-50 font-mono text-[0.7rem] tracking-[0.16em] uppercase underline underline-offset-8 transition"
      >
        {T.verServicios}
      </a>
    </div>

    <dl
      class="border-fondo-50/20 mx-auto mt-16 flex max-w-sm justify-center gap-14 border-t pt-8"
    >
      <div>
        <dt class="text-laton-300 font-mono text-[0.65rem] tracking-[0.16em] uppercase">
          {T.heroSucursales}
        </dt>
        <dd class="text-fondo-50 mt-2 font-mono text-2xl tabular-nums">
          {sucursales.length}
        </dd>
      </div>
      <div>
        <dt class="text-laton-300 font-mono text-[0.65rem] tracking-[0.16em] uppercase">
          {T.heroAbrimos}
        </dt>
        <dd class="text-fondo-50 mt-2 font-mono text-2xl tabular-nums">
          {`${diasAbiertos} ${T.heroDias}`}
        </dd>
      </div>
    </dl>
  </div>
</section>

<script>
  // El video de la portada es decorativo y solo se descarga cuando aporta algo.
  // Se queda en el poster —ya pintado y sin coste extra— en tres casos: en
  // movil, donde ocupa poco y se ve el recorte central; con
  // "prefers-reduced-motion", porque animar el fondo es justo lo que esa
  // preferencia pide evitar; y con el ahorro de datos activado.
  const video = document.querySelector<HTMLVideoElement>('[data-video-portada]');

  if (video) {
    const escritorio = window.matchMedia('(min-width: 768px)');
    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)');
    const conexion = (navigator as Navigator & { connection?: { saveData?: boolean } })
      .connection;

    const revisar = () => {
      if (!escritorio.matches || reducir.matches || conexion?.saveData) {
        video.pause();
        return;
      }

      video.preload = 'auto';
      // Si el archivo no esta, play() rechaza: se queda el poster y ya.
      video.play().catch(() => {});
    };

    // Se reevalua al cambiar el ancho o la preferencia: quien carga la pagina
    // en una ventana estrecha y luego la maximiza tambien merece el video, y
    // quien activa el movimiento reducido merece que se pare al momento.
    escritorio.addEventListener('change', revisar);
    reducir.addEventListener('change', revisar);
    revisar();
  }
</script>
