---
import { negocio, sucursales } from '../data/site';

// Las cifras salen de los datos para que no se queden desfasadas.
const principal = sucursales[0]!;
const diasAbiertos = principal.horarios
  .filter((franja) => !franja.cerrado)
  .reduce((total, franja) => total + franja.indices.length, 0);
---

<section id="inicio" class="relative overflow-hidden pt-20">
  <!-- Fondo: destello calido arriba a la izquierda y rejilla tenue de barberia. -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="bg-laton-600/12 absolute -top-40 -left-40 size-[38rem] rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: linear-gradient(var(--color-hueso-50) 1px, transparent 1px), linear-gradient(90deg, var(--color-hueso-50) 1px, transparent 1px); background-size: 72px 72px;"
    >
    </div>
    <div
      class="from-tinta-950 absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t to-transparent"
    >
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 py-20 md:py-32">
    <div class="max-w-3xl">
      <p
        class="border-laton-500/30 bg-laton-500/8 text-laton-400 inline-flex items-center gap-2.5 rounded-full border px-4 py-1.5 text-xs font-semibold tracking-[0.18em] uppercase"
      >
        <span class="bg-laton-400 size-1.5 rounded-full"></span>
        {principal.direccion.ciudad}, {principal.direccion.region}
      </p>

      <h1 class="mt-7 text-6xl leading-[0.92] sm:text-7xl md:text-8xl">
        Corte clasico,<br />
        <span class="text-laton-400">cuidado moderno</span>
      </h1>

      <p class="text-hueso-300 mt-7 max-w-xl text-lg leading-relaxed">
        {negocio.descripcion}
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#sucursales"
          class="bg-laton-500 text-tinta-950 hover:bg-laton-400 inline-flex items-center justify-center gap-2.5 rounded-full px-8 py-4 font-semibold transition"
        >
          Agendar cita
        </a>
        <a
          href="#servicios"
          class="border-tinta-600 text-hueso-100 hover:border-laton-500 hover:text-laton-400 inline-flex items-center justify-center gap-2.5 rounded-full border px-8 py-4 font-semibold transition"
        >
          Ver servicios
        </a>
      </div>

      <!-- Valores cortos a proposito: las tres columnas tienen que caber en
           un movil estrecho sin partir palabras. -->
      <dl class="mt-14 grid max-w-lg grid-cols-3 gap-6">
        <div>
          <dt class="text-hueso-400 text-xs tracking-[0.14em] uppercase">Sucursales</dt>
          <dd class="font-display text-hueso-50 mt-1.5 text-2xl sm:text-3xl">
            {sucursales.length}
          </dd>
        </div>
        <div>
          <dt class="text-hueso-400 text-xs tracking-[0.14em] uppercase">Abrimos</dt>
          <dd class="font-display text-hueso-50 mt-1.5 text-2xl sm:text-3xl">
            {diasAbiertos} dias
          </dd>
        </div>
        <div>
          <dt class="text-hueso-400 text-xs tracking-[0.14em] uppercase">Desde</dt>
          <dd class="font-display text-hueso-50 mt-1.5 text-2xl sm:text-3xl">
            {negocio.desde}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
