---
import { Image } from 'astro:assets';
import { negocio, sucursales } from '../data/site';
import { idiomaDe, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';
import fachada from '../assets/portada/fachada-la-joya.jpg';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);
---

{
  /* Portada a sangre. 92vh y no 100vh a proposito: que asome el borde de la
    seccion siguiente es lo que dice que la pagina continua.

    En movil baja a 72vh y la foto se muestra entera arriba en vez de recortada
    a sangre. Una foto 4:3 en un hueco vertical obliga a recortar de los lados,
    que es justo donde estan los extremos del rotulo: se leia "DIO BARBER SHOP".
    Como banda superior se ve el rotulo completo, y el resto del alto lo ocupa
    el verde del velo, que es donde cae el texto. */
}
<section
  id="inicio"
  class="bg-salvia-950 relative flex min-h-[72vh] items-end justify-center overflow-hidden sm:min-h-[92vh]"
>
  {
    /* La fachada del local. Antes habia un plano del mar porque no existia
      ninguna foto horizontal del sitio; esta dice en dos segundos que esto es
      una barberia, que es lo que el mar no hacia.

      El encuadre va al 42% y no centrado: la fuente es 4:3 y la portada casi
      16:9, asi que al recortar se pierde alto. Sesgado hacia arriba se conserva
      el rotulo, que es lo que identifica al negocio, y lo que se va es acera. */
  }
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={fachada}
      alt=""
      widths={[640, 960, 1280]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="size-full object-contain object-top sm:object-cover sm:object-[center_42%]"
    />

    {
      /* El velo es el verde de marca llevado al fondo de la escala, no un
        negro: el cliente descarto el negro y asi la foto sigue dentro de la
        paleta. El degradado vertical carga arriba, donde va la cabecera, y
        abajo, donde acaba el texto. */
    }
    <div class="bg-salvia-950/62 absolute inset-0"></div>
    <div
      class="from-salvia-950/75 to-salvia-950/85 absolute inset-0 bg-gradient-to-b via-transparent"
    >
    </div>
  </div>

  {
    /* El texto se alinea abajo y no al centro: el rotulo de madera ocupa el
      tercio superior de la foto y es lo que identifica al negocio. Centrado, el
      titular le caia justo encima. */
  }
  <div class="relative mx-auto max-w-3xl px-5 pt-32 pb-16 text-center sm:pt-40 sm:pb-20">
    <p class="antetitulo antetitulo-claro justify-center">
      {rellenar(T.heroAntetitulo, { n: sucursales.length })}
    </p>

    <h1 class="text-fondo-50 mt-8 text-5xl sm:text-6xl md:text-7xl">
      {T.heroH1}
    </h1>

    <p class="font-display text-pared-200 mt-6 text-2xl italic sm:text-3xl">
      {t(negocio.eslogan, idioma)}
    </p>

    <p class="text-fondo-100 mx-auto mt-8 max-w-xl leading-relaxed">
      {t(negocio.descripcion, idioma)}
    </p>

    {
      /* Un boton principal, como en las barberias que se ven bien: la accion
        que importa es agendar, y darle un segundo boton del mismo peso la
        diluye. El de servicios va debajo, como enlace. */
    }
    <div class="mt-11 flex flex-col items-center gap-6">
      <a
        href="#sucursales"
        class="bg-fondo-50 text-salvia-700 hover:bg-fondo-150 inline-flex items-center justify-center rounded-full px-10 py-4 font-semibold transition"
      >
        {T.agendarCita}
      </a>

      <a
        href="#servicios"
        class="text-fondo-100 hover:text-fondo-50 font-mono text-[0.7rem] tracking-[0.16em] uppercase underline underline-offset-8 transition"
      >
        {T.verServicios}
      </a>
    </div>
  </div>
</section>
