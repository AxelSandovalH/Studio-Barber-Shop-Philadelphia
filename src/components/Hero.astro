---
import { Image } from 'astro:assets';
import { negocio, sucursales } from '../data/site';
import { idiomaDe, t } from '../i18n/idiomas';
import { rellenar, textos } from '../i18n/textos';
import fachada from '../assets/portada/fachada-la-joya.jpg';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);
---

{
  /* Portada partida: el texto en su mitad y la foto en la otra.

    Se probo antes a sangre, con la foto de fondo y un velo encima. El problema
    de ese montaje es que el velo es lo unico que separa el texto de la foto:
    para que se lea hay que taparla al 62%, y entonces la fachada se ve apagada
    justo cuando lo que se queria era ensenarla. Partida, cada cosa tiene su
    sitio: el texto se lee sobre verde solido y la foto va **sin velo ninguno**.

    Tambien le viene bien a esta foto en concreto, que mide 1280 px de ancho: a
    media pantalla le sobra resolucion, y a pantalla completa se quedaba corta.

    La cabecera vuelve a ser solida sobre esta portada. Transparente no vale: en
    movil la foto sube hasta arriba y el rotulo en claro se perderia sobre el
    cielo. De ahi el `pt-20`, que es su altura. */
}
<section
  id="inicio"
  class="bg-salvia-950 relative grid min-h-[92vh] pt-20 lg:grid-cols-2"
>
  {
    /* En movil la foto va arriba, a su proporcion 4:3 y entera: recortada a un
      hueco vertical se pierden los extremos del rotulo, que es justo lo que
      identifica al negocio. */
  }
  <div class="order-first lg:order-last">
    <Image
      src={fachada}
      alt={`Fachada de ${negocio.nombre}, sucursal ${sucursales[1]?.nombre ?? ''}`}
      widths={[640, 960, 1280]}
      sizes="(max-width: 1023px) 100vw, 50vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="aspect-[4/3] w-full object-cover lg:aspect-auto lg:h-full"
    />
  </div>

  <div class="flex items-center px-5 py-16 sm:px-10 md:py-24 lg:px-14">
    <div class="mx-auto w-full max-w-xl">
      <p class="antetitulo antetitulo-claro">
        {rellenar(T.heroAntetitulo, { n: sucursales.length })}
      </p>

      <h1 class="text-fondo-50 mt-8 text-5xl sm:text-6xl">
        {T.heroH1}
      </h1>

      <p class="font-display text-pared-200 mt-6 text-2xl italic sm:text-3xl">
        {t(negocio.eslogan, idioma)}
      </p>

      <p class="text-fondo-100 mt-8 leading-relaxed">
        {t(negocio.descripcion, idioma)}
      </p>

      {
        /* Un boton principal, como en las barberias que se ven bien: la accion
          que importa es agendar, y darle un segundo boton del mismo peso la
          diluye. El de servicios va al lado, como enlace. */
      }
      <div class="mt-11 flex flex-wrap items-center gap-x-10 gap-y-5">
        <a
          href="#sucursales"
          class="bg-fondo-50 text-salvia-700 hover:bg-fondo-150 inline-flex items-center justify-center rounded-full px-10 py-4 font-semibold transition"
        >
          {T.agendarCita}
        </a>

        <a
          href="#servicios"
          class="text-fondo-100 hover:text-fondo-50 font-mono text-[0.7rem] tracking-[0.16em] uppercase underline underline-offset-8 transition"
        >
          {T.verServicios}
        </a>
      </div>
    </div>
  </div>
</section>
