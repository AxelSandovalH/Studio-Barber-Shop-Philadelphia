---
import { galeria, negocio } from '../data/site';
import TituloSeccion from './TituloSeccion.astro';
import Carrusel from './Carrusel.astro';

const instagram = negocio.redes.find((red) => red.nombre === 'Instagram');
---

<section
  id="galeria"
  class="border-tinta-800 bg-tinta-900/40 overflow-hidden border-t py-24 md:py-32"
>
  <div class="mx-auto max-w-6xl px-5">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <TituloSeccion
        etiqueta="Nuestro trabajo"
        titulo="El resultado habla"
        descripcion="Una muestra de los cortes que salen del local cada semana."
      />
      {
        instagram && (
          <a
            href={instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="border-tinta-600 text-hueso-100 hover:border-laton-500 hover:text-laton-400 inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-semibold transition"
          >
            Ver mas en Instagram
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </a>
        )
      }
    </div>

    <div class="mt-14">
      <Carrusel medios={galeria} etiqueta="Galeria de trabajos" />
    </div>
  </div>
</section>
