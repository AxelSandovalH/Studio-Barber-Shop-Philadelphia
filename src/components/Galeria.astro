---
import { galeria, negocio, serviciosDeGaleria } from '../data/site';
import { idiomaDe, t } from '../i18n/idiomas';
import { textos } from '../i18n/textos';
import TituloSeccion from './TituloSeccion.astro';
import Carrusel from './Carrusel.astro';

const idioma = idiomaDe(Astro.currentLocale);
const T = textos(idioma);

const instagram = negocio.redes.find((red) => red.nombre === 'Instagram');

// Los filtros salen de la carta de servicios, no de una lista escrita aparte:
// el nombre y su traduccion ya existen ahi. Solo aparecen los servicios que
// tienen material etiquetado, asi que una categoria vacia no llega a verse.
const filtros = serviciosDeGaleria().map((servicio) => ({
  clave: servicio.clave,
  etiqueta: t(servicio.nombre, idioma),
}));
---

<section
  id="galeria"
  class="border-fondo-200 bg-pared-100 overflow-hidden border-t py-24 md:py-32"
>
  <div class="mx-auto max-w-6xl px-5">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <TituloSeccion
        etiqueta={T.galeriaEtiqueta}
        titulo={T.galeriaTitulo}
        descripcion={T.galeriaDescripcion}
      />
      {
        instagram && (
          <a
            href={instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="border-fondo-400 text-tinta-900 hover:border-salvia-600 hover:text-salvia-700 inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-semibold transition"
          >
            {T.verMasInstagram}
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </a>
        )
      }
    </div>

    <div class="mt-14">
      <Carrusel medios={galeria} etiqueta={T.galeriaRegion} filtros={filtros} />
    </div>
  </div>
</section>
